# --- .NET ---
bin/
obj/
*.user
*.suo
.vs/

# --- Logs ---
logs/
*.log

# --- Python / face-service ---
face-service/.venv/
face-service/__pycache__/
face-service/**/__pycache__/
face-service/*.egg-info/
**/*.pyc

# --- Flutter ---
guardian_app/.dart_tool/
guardian_app/.flutter-plugins
guardian_app/.flutter-plugins-dependencies
guardian_app/build/
guardian_app/android/.gradle/
guardian_app/android/local.properties
guardian_app/ios/Pods/
guardian_app/ios/.symlinks/
guardian_app/*.iml

# --- Secrets / local config (never commit real values) ---
appsettings.*.local.json
*.pfx

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/

# --- Local tooling artifacts ---
.playwright-mcp/

# --- Playwright E2E ---
tests/e2e/node_modules/
# Test-stack build, logs, inventory and state (holds the throwaway admin password).
tests/e2e/.e2e/
tests/e2e/playwright-report/
tests/e2e/test-results/

# Brainstorm mockups
.superpowers/

# Face evaluation: datasets and caches are never committed
face-service/eval/datasets/
face-service/eval/cache/

# Local database backups (contain personal data)
backups/

# E2E auth state (session tokens) and failure evidence (screens/traces may show personal data)
tests/e2e/.auth/
tests/e2e/reports/evidence/

# Neon / Node tooling: connection strings and local context are secrets, never committed
.env
.env.*
!.env.example
.neon
node_modules/
