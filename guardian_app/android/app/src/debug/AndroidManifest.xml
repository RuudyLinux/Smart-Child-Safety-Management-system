<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Development only: the local API is plain http (adb reverse / LAN address). Android 9+ blocks that
         by default, which shows up as "Could not reach server". The release manifest does not set this,
         so a release build only talks https. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
