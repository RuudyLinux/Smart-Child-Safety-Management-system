@model DashboardSummaryDto
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    var greeting = SchoolTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };
    var adminFirstName = (User.Identity?.Name ?? "Admin").Split(' ')[0];
}

<div class="cg-dash-live" data-cg-live-bar hidden>
    <span class="cg-muted cg-text-sm" data-cg-live-status role="status" aria-live="polite"></span>
    <button type="button" class="cg-btn cg-btn--ghost cg-btn--sm" data-cg-live-refresh>Refresh</button>
</div>
<div data-cg-region="dash-live">
@if (Model is null)
{
    <div class="cg-alert cg-alert--danger" role="alert">
        <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
        <div class="cg-alert__body">
            <div class="cg-alert__title">Dashboard data could not be loaded</div>
            <div>@(ViewBag.LoadError as string ?? "The ChildGuard API did not respond.") <a href="/Diagnostics">Run diagnostics</a>.</div>
        </div>
    </div>
    @:</div>
    return;
}

@{
    var attendance = Model.Attendance;
    var journey = Model.Journey;
    var transport = Model.Transport;
    var criticalCount = Model.Alerts.Count(a => a.Severity == AlertSeverity.Critical);
    var warningCount = Model.Alerts.Count(a => a.Severity == AlertSeverity.Warning);

    // The headline answer to "are the children safe right now?" — derived only
    // from recorded conditions, never assumed.
    var (statusPulse, statusHeadline, statusDetail) = criticalCount > 0
        ? ("cg-pulse--danger", $"{criticalCount} critical alert{(criticalCount == 1 ? "" : "s")}", "Needs immediate attention")
        : warningCount > 0
            ? ("cg-pulse--warning", $"{warningCount} item{(warningCount == 1 ? "" : "s")} to review", "No critical issues")
            : ("", "All systems operational", "No open safety alerts");

    var trend = Model.AttendanceTrend.ToList();
}

<section class="cg-hero">
    <div class="cg-hero__inner">
        <div>
            <h1 class="cg-hero__greeting">@greeting, @adminFirstName</h1>
            <p class="cg-hero__sub">
                @SchoolTime.Now.ToString("dddd, d MMMM yyyy") — here is your school's safety overview.
            </p>
            <div class="cg-hero__meta">
                <div>
                    <div class="cg-hero__stat-label">On roll</div>
                    <div class="cg-hero__stat-value">@Model.TotalStudents student@(Model.TotalStudents == 1 ? "" : "s")</div>
                </div>
                <div>
                    <div class="cg-hero__stat-label">At school now</div>
                    <div class="cg-hero__stat-value">@journey.AtSchool</div>
                </div>
                <div>
                    <div class="cg-hero__stat-label">Checkpoints today</div>
                    <div class="cg-hero__stat-value">@Model.TodaysJourneyEventCount</div>
                </div>
                @if (Model.SchoolDay is { } schoolDay)
                {
                    <div>
                        <div class="cg-hero__stat-label"><a href="/SchoolTime" style="color:inherit">School day</a></div>
                        <div class="cg-hero__stat-value">
                            @if (schoolDay.IsSchoolDay)
                            {
                                @($"{schoolDay.StartTime:HH:mm}–{schoolDay.DismissalTime:HH:mm}")
                                @if (schoolDay.Title is not null) { <span> · @schoolDay.Title</span> }
                            }
                            else
                            {
                                @($"Closed{(schoolDay.Title is null ? "" : $" · {schoolDay.Title}")}")
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <a class="cg-sysstatus" href="#alerts" style="text-decoration:none">
            <span class="cg-pulse @statusPulse"></span>
            <span>
                <span class="cg-sysstatus__label">@statusDetail</span>
                @statusHeadline
            </span>
        </a>
    </div>
</section>

<div class="cg-grid cg-grid--kpi">

    @* Primary KPI: today's attendance, with the breakdown and the day-on-day move. *@
    <article class="cg-kpi cg-kpi--hero">
        <div class="cg-kpi__top">
            <div>
                <div class="cg-kpi__label">Today's attendance</div>
                <div class="cg-kpi__value">
                    @attendance.PresentRate.ToString("0.#", CultureInfo.InvariantCulture)<span class="cg-kpi__unit">%</span>
                </div>
            </div>
            <span class="cg-kpi__icon cg-kpi__icon--success">@await Html.PartialAsync("_Icon", "attendance")</span>
        </div>

        <div class="cg-kpi__foot">
            @if (attendance.RateChange is { } change && change != 0)
            {
                <span class="cg-delta @(change > 0 ? "cg-delta--up" : "cg-delta--down")">
                    @await Html.PartialAsync("_Icon", change > 0 ? "arrow-up" : "arrow-down")
                    @Math.Abs(change).ToString("0.#", CultureInfo.InvariantCulture)%
                </span>
                <span class="cg-kpi__note">vs previous school day</span>
            }
            else if (attendance.PreviousDayPresentRate is null)
            {
                <span class="cg-kpi__note">No previous school day to compare against.</span>
            }
            else
            {
                <span class="cg-delta cg-delta--flat">No change</span>
                <span class="cg-kpi__note">vs previous school day</span>
            }
        </div>

        @{
            var present = attendance.Present;
            var late = attendance.Late;
            var absent = attendance.Absent;
            var roster = Math.Max(1, attendance.RosterSize);
            string Pct(int n) => (n * 100.0 / roster).ToString("0.##", CultureInfo.InvariantCulture);
        }
        <div class="cg-stackbar" role="img"
             aria-label="@present present, @late late, @absent absent of @attendance.RosterSize students">
            <span class="cg-stackbar__part" style="width:@Pct(present - late)%;background:var(--cg-success)"></span>
            <span class="cg-stackbar__part" style="width:@Pct(late)%;background:var(--cg-warning-accent)"></span>
            <span class="cg-stackbar__part" style="width:@Pct(absent)%;background:var(--cg-border-strong)"></span>
        </div>

        <div class="cg-kpi__breakdown">
            <div class="cg-kpi__breakdown-item">
                <div class="cg-kpi__breakdown-label"><span class="cg-badge__dot" style="color:var(--cg-success)"></span>Present</div>
                <div class="cg-kpi__breakdown-value">@present</div>
            </div>
            <div class="cg-kpi__breakdown-item">
                <div class="cg-kpi__breakdown-label"><span class="cg-badge__dot" style="color:var(--cg-warning-accent)"></span>Late</div>
                <div class="cg-kpi__breakdown-value">@late</div>
            </div>
            <div class="cg-kpi__breakdown-item">
                <div class="cg-kpi__breakdown-label"><span class="cg-badge__dot" style="color:var(--cg-muted-2)"></span>Absent</div>
                <div class="cg-kpi__breakdown-value">@absent</div>
            </div>
            <div class="cg-kpi__breakdown-item">
                <div class="cg-kpi__breakdown-label">Late after</div>
                <div class="cg-kpi__breakdown-value">@attendance.LateAfter</div>
            </div>
        </div>
    </article>

    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Total students</div>
            <span class="cg-kpi__icon">@await Html.PartialAsync("_Icon", "students")</span>
        </div>
        <div class="cg-kpi__value">@Model.TotalStudents</div>
        <div class="cg-kpi__foot">
            <span class="cg-badge cg-badge--neutral">@Model.ActiveRfidCards RFID cards active</span>
        </div>
    </article>

    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Active guardians</div>
            <span class="cg-kpi__icon cg-kpi__icon--info">@await Html.PartialAsync("_Icon", "guardians")</span>
        </div>
        <div class="cg-kpi__value">@Model.TotalGuardians</div>
        <div class="cg-kpi__foot">
            <a class="cg-text-sm" href="/Guardians">Manage guardians</a>
        </div>
    </article>

    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Buses in service</div>
            <span class="cg-kpi__icon cg-kpi__icon--neutral">@await Html.PartialAsync("_Icon", "bus")</span>
        </div>
        <div class="cg-kpi__value">@transport.ActiveBuses</div>
        <div class="cg-kpi__foot">
            <span class="cg-kpi__note">@transport.StudentsAssigned assigned · @transport.StudentsUnassigned unassigned</span>
        </div>
    </article>

    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Pending verifications</div>
            <span class="cg-kpi__icon @(Model.PendingVerifications > 0 ? "cg-kpi__icon--warning" : "cg-kpi__icon--neutral")">
                @await Html.PartialAsync("_Icon", "pickup")
            </span>
        </div>
        <div class="cg-kpi__value">@Model.PendingVerifications</div>
        <div class="cg-kpi__foot">
            @if (Model.PendingVerifications > 0)
            {
                <a class="cg-btn cg-btn--sm cg-btn--secondary" href="/Verification">Open pickup desk</a>
            }
            else
            {
                <span class="cg-kpi__note">No handovers waiting on a decision.</span>
            }
        </div>
    </article>

    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Safety alerts</div>
            <span class="cg-kpi__icon @(criticalCount > 0 ? "cg-kpi__icon--danger" : warningCount > 0 ? "cg-kpi__icon--warning" : "cg-kpi__icon--success")">
                @await Html.PartialAsync("_Icon", criticalCount > 0 ? "alert-octagon" : "shield-check")
            </span>
        </div>
        <div class="cg-kpi__value">@Model.Alerts.Count</div>
        <div class="cg-kpi__foot">
            @if (criticalCount > 0)
            {
                <span class="cg-badge cg-badge--danger"><span class="cg-badge__dot"></span>@criticalCount critical</span>
            }
            @if (warningCount > 0)
            {
                <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>@warningCount to review</span>
            }
            @if (Model.Alerts.Count == 0)
            {
                <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>All clear</span>
            }
        </div>
    </article>
</div>

@if (Model.Admin is { } adm)
{
    var g = adm.Gaps;
    <div class="cg-grid cg-grid--4" data-admin-overview>
        <section class="cg-card" data-kpi="people">
            <div class="cg-card__head"><h2 class="cg-card__title">People</h2><a class="cg-text-sm" href="/Students">Students</a></div>
            <div class="cg-card__body">
                <dl class="cg-deflist">
                    <dt>Students</dt><dd><strong data-kpi-value="students-active">@adm.People.ActiveStudents</strong> active of @adm.People.Students</dd>
                    <dt>Inactive · archived</dt><dd>@adm.People.InactiveStudents · @adm.People.ArchivedStudents</dd>
                    <dt>Guardians</dt><dd><strong data-kpi-value="guardians-active">@adm.People.ActiveGuardians</strong> active of @adm.People.Guardians</dd>
                    <dt>Inactive · archived</dt><dd>@adm.People.InactiveGuardians · @adm.People.ArchivedGuardians</dd>
                </dl>
            </div>
        </section>
        <section class="cg-card" data-kpi="rfid">
            <div class="cg-card__head"><h2 class="cg-card__title">RFID cards</h2><a class="cg-text-sm" href="/Rfid">Inventory</a></div>
            <div class="cg-card__body">
                <dl class="cg-deflist">
                    <dt>Assigned</dt><dd data-kpi-value="rfid-assigned">@adm.Rfid.Assigned</dd>
                    <dt>Spare, ready</dt><dd data-kpi-value="rfid-available">@adm.Rfid.Available</dd>
                    <dt>Lost · damaged</dt><dd>@adm.Rfid.Lost · @adm.Rfid.Damaged</dd>
                    <dt>Inactive · retired</dt><dd>@adm.Rfid.Inactive · @adm.Rfid.Retired</dd>
                </dl>
                <p class="cg-hint" style="margin:6px 0 0">@adm.Rfid.Total cards on record</p>
            </div>
        </section>
        <section class="cg-card" data-kpi="fleet">
            <div class="cg-card__head"><h2 class="cg-card__title">Fleet</h2><a class="cg-text-sm" href="/Transportation">Transportation</a></div>
            <div class="cg-card__body">
                <dl class="cg-deflist">
                    <dt>Buses in service</dt><dd><strong data-kpi-value="buses-active">@adm.Fleet.BusesActive</strong> of @adm.Fleet.Buses</dd>
                    <dt>Maintenance · out</dt><dd>@adm.Fleet.BusesUnderMaintenance · @adm.Fleet.BusesOutOfService</dd>
                    <dt>Drivers</dt><dd>@adm.Fleet.ActiveDrivers active of @adm.Fleet.Drivers</dd>
                    <dt>Routes</dt><dd>@adm.Fleet.ActiveRoutes active of @adm.Fleet.Routes</dd>
                    <dt>Students riding</dt><dd data-kpi-value="students-assigned">@adm.Fleet.StudentsAssigned</dd>
                </dl>
            </div>
        </section>
        <section class="cg-card" data-kpi="gaps">
            <div class="cg-card__head"><h2 class="cg-card__title">Needs follow-up</h2></div>
            <div class="cg-card__body">
                <dl class="cg-deflist">
                    <dt>No active guardian</dt><dd data-kpi-value="gap-guardian">@g.StudentsWithoutGuardian</dd>
                    <dt>No RFID card</dt><dd data-kpi-value="gap-rfid">@g.StudentsWithoutRfid</dd>
                    <dt>No transport</dt><dd data-kpi-value="gap-transport">@g.StudentsWithoutTransport</dd>
                    <dt>Licences expired</dt><dd data-kpi-value="licence-expired">@if (g.LicencesExpired > 0) { <span class="cg-badge cg-badge--danger">@g.LicencesExpired</span> } else { @("0") }</dd>
                    <dt>Expiring in @ChildGuard.Application.Common.LicenceRules.WarnDays days</dt><dd data-kpi-value="licence-expiring">@if (g.LicencesExpiringSoon > 0) { <span class="cg-badge cg-badge--warning">@g.LicencesExpiringSoon</span> } else { @("0") }</dd>
                    <dt>Licence not recorded</dt><dd>@g.LicencesNotRecorded</dd>
                </dl>
            </div>
        </section>
    </div>

    @if (adm.Fleet.BusLoads.Count > 0)
    {
        <section class="cg-card" data-bus-loads>
            <div class="cg-card__head">
                <div>
                    <h2 class="cg-card__title">Students per bus</h2>
                    <div class="cg-card__sub">Seats taken by current assignments@(adm.Fleet.BusLoads.Count > 10 ? $", the 10 fullest of {adm.Fleet.BusLoads.Count} buses" : "")</div>
                </div>
                <a class="cg-text-sm" href="/Transportation">All buses</a>
            </div>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead><tr><th>Bus</th><th>Status</th><th>Students</th><th>Capacity</th><th style="width:35%">Load</th></tr></thead>
                    <tbody>
                    @foreach (var b in adm.Fleet.BusLoads
                        .OrderByDescending(b => b.Capacity == 0 ? 0 : b.Students * 1.0 / b.Capacity).ThenBy(b => b.BusNumber).Take(10))
                    {
                        var pct = b.Capacity == 0 ? 0 : Math.Min(100, (int)Math.Round(b.Students * 100.0 / b.Capacity));
                        <tr data-bus-load="@b.BusNumber">
                            <td><a href="/Transportation/Bus/@b.BusId">@b.BusNumber</a></td>
                            <td>@await Html.PartialAsync("~/Views/Transportation/_Ui.cshtml", ("bus", (object)b.Status))</td>
                            <td>@b.Students</td>
                            <td>@b.Capacity</td>
                            <td>
                                <div role="img" aria-label="@pct% full" style="height:8px;border-radius:4px;background:var(--cg-border, #e5e7eb);overflow:hidden">
                                    <div style="height:100%;width:@(pct)%;background:@(pct >= 100 ? "var(--cg-danger)" : pct >= 85 ? "var(--cg-warning)" : "var(--cg-primary)")"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

<div class="cg-grid cg-grid--sidebar">
    <div>
        @* --- Attendance trend ------------------------------------------------ *@
        <section class="cg-card">
            <div class="cg-card__head">
                <div>
                    <h2 class="cg-card__title">Attendance trend</h2>
                    <div class="cg-card__sub">Distinct students checked in per day, last @trend.Count days</div>
                </div>
                <a class="cg-btn cg-btn--sm cg-btn--ghost" href="/Attendance">
                    Open attendance @await Html.PartialAsync("_Icon", "chevron-right")
                </a>
            </div>
            <div class="cg-card__body">
                @if (trend.All(p => p.Present == 0))
                {
                    @await Html.PartialAsync("_EmptyState", ("attendance", "No attendance recorded yet",
                        "Once students start scanning in at a checkpoint, their daily attendance appears here.",
                        (string?)null, (string?)null))
                }
                else
                {
                    // Plotted by hand: a small polyline needs no charting library,
                        // so the page has nothing to download and nothing to block on.
                        const int chartW = 720, chartH = 180, padX = 10, padTop = 12, padBottom = 26;
                        var maxValue = Math.Max(1, trend.Max(p => p.RosterSize));
                        var stepX = trend.Count > 1 ? (chartW - padX * 2) / (double)(trend.Count - 1) : 0;
                        var baseline = chartH - padBottom;

                        var xs = trend.Select((_, i) => padX + i * stepX).ToArray();
                        var ys = trend.Select(p => padTop + (baseline - padTop) * (1 - p.Present / (double)maxValue)).ToArray();

                        string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

                        var linePoints = string.Join(" ", xs.Select((x, i) => $"{N(x)},{N(ys[i])}"));

                        // The area repeats the line and closes on the baseline, so the
                        // fill sits under the curve rather than around it.
                    var area = new System.Text.StringBuilder($"M {N(xs[0])} {N(baseline)}");
                    for (var i = 0; i < xs.Length; i++) area.Append($" L {N(xs[i])} {N(ys[i])}");
                    area.Append($" L {N(xs[^1])} {N(baseline)} Z");
                    <svg class="cg-chart" viewBox="0 0 @chartW @chartH" preserveAspectRatio="none" role="img"
                         aria-label="Attendance for the last @trend.Count days">
                        <defs>
                            <linearGradient id="cgAreaFill" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#3978D5" stop-opacity="0.26" />
                                <stop offset="100%" stop-color="#8B7FE8" stop-opacity="0.02" />
                            </linearGradient>
                        </defs>

                        @for (var g = 0; g <= 2; g++)
                        {
                            var gridY = N(padTop + (baseline - padTop) * g / 2.0);
                            <line class="cg-chart__grid" x1="@padX" x2="@(chartW - padX)" y1="@gridY" y2="@gridY" />
                        }

                        <path class="cg-chart__area" d="@area.ToString()" />
                        <polyline class="cg-chart__line" points="@linePoints" pathLength="1" />

                        @for (var i = 0; i < trend.Count; i++)
                        {
                            <circle class="cg-chart__dot" r="3.5" cx="@N(xs[i])" cy="@N(ys[i])">
                                <title>@trend[i].Date.ToString("ddd d MMM"): @trend[i].Present of @trend[i].RosterSize present</title>
                            </circle>
                        }
                    </svg>

                    @* Day labels sit outside the SVG: the plot is stretched to the card
                       width, and text inside it would be stretched with it. *@
                    <div class="cg-row" style="justify-content:space-between;margin-top:2px">
                        @foreach (var point in trend)
                        {
                            <span class="cg-text-sm cg-muted" title="@point.Date.ToString("d MMM yyyy")">
                                @point.Date.ToString("ddd")
                            </span>
                        }
                    </div>

                    <div class="cg-chart-legend">
                        <span class="cg-chart-legend__item">
                            <span class="cg-chart-legend__swatch" style="background:var(--cg-primary)"></span>
                            Students checked in
                        </span>
                        <span class="cg-chart-legend__item cg-muted">
                            Peak of @trend.Max(p => p.Present) · roster @trend[^1].RosterSize
                        </span>
                    </div>
                }
            </div>
        </section>

        @* --- Journey status --------------------------------------------------- *@
        <section class="cg-card">
            <div class="cg-card__head">
                <div>
                    <h2 class="cg-card__title">Where students are now</h2>
                    <div class="cg-card__sub">From each student's latest recorded checkpoint today</div>
                </div>
                <a class="cg-btn cg-btn--sm cg-btn--ghost" href="/Journey">
                    Journey board @await Html.PartialAsync("_Icon", "chevron-right")
                </a>
            </div>
            <div class="cg-card__body">
                @{
                    var journeySegments = new (string Label, int Value, string Color)[]
                    {
                        ("At school", journey.AtSchool, "#16A36A"),
                        ("On the bus", journey.OnBusToSchool, "#2B8FC9"),
                        ("Left school", journey.LeftSchool, "#E99A32"),
                        ("Dropped off", journey.DroppedOffHome, "#8B7FE8"),
                        ("No activity", journey.NoActivityToday, "#CDD6E4")
                    };
                    var journeyTotal = journeySegments.Sum(s => s.Value);
                }

                @if (journeyTotal == 0)
                {
                    @await Html.PartialAsync("_EmptyState", ("journey", "No journey activity today",
                        "Checkpoint scans recorded today will place each student on this board.",
                        (string?)null, (string?)null))
                }
                else
                {
                    // Donut drawn with stroke-dasharray on one circle per slice:
                        // exact, and it scales without any layout maths.
                        const double radius = 54;
                        var circumference = 2 * Math.PI * radius;
                        var drawn = journeySegments.Where(seg => seg.Value > 0).ToList();

                        // Each slice starts where the previous one ended.
                        var lengths = drawn.Select(seg => circumference * seg.Value / journeyTotal).ToArray();
                        var offsets = new double[lengths.Length];
                        for (var i = 1; i < lengths.Length; i++) offsets[i] = offsets[i - 1] + lengths[i - 1];

                    string D(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
                    <div class="cg-donut">
                        <div class="cg-donut__figure">
                            <svg width="140" height="140" viewBox="0 0 140 140" role="img"
                                 aria-label="Journey status of @journeyTotal students">
                                <g transform="rotate(-90 70 70)">
                                    @for (var i = 0; i < drawn.Count; i++)
                                    {
                                        <circle class="cg-donut__segment" cx="70" cy="70" r="@radius" fill="none"
                                                stroke="@drawn[i].Color" stroke-width="18"
                                                stroke-dasharray="@D(lengths[i]) @D(circumference - lengths[i])"
                                                stroke-dashoffset="@D(-offsets[i])">
                                            <title>@drawn[i].Label: @drawn[i].Value</title>
                                        </circle>
                                    }
                                </g>
                            </svg>
                            <div class="cg-donut__center">
                                <div class="cg-donut__center-value">@journeyTotal</div>
                                <div class="cg-donut__center-label">student@(journeyTotal == 1 ? "" : "s")</div>
                            </div>
                        </div>

                        <div class="cg-donut__list">
                            @foreach (var segment in journeySegments)
                            {
                                <div class="cg-donut__row">
                                    <span class="cg-chart-legend__swatch" style="background:@segment.Color"></span>
                                    <span class="cg-donut__row-name">@segment.Label</span>
                                    <span class="cg-donut__row-value">@segment.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        @* --- Attendance by grade --------------------------------------------- *@
        @if (Model.AttendanceByGrade.Any())
        {
            <section class="cg-card">
                <div class="cg-card__head">
                    <h2 class="cg-card__title">Attendance by grade</h2>
                    <div class="cg-card__sub">Checked in today</div>
                </div>
                <div class="cg-card__body">
                    <div class="cg-bars">
                        @foreach (var grade in Model.AttendanceByGrade)
                        {
                            var fill = grade.PresentRate >= 90 ? "cg-bar__fill--success"
                                : grade.PresentRate >= 70 ? "" : "cg-bar__fill--warning";
                            <div>
                                <div class="cg-bar__head">
                                    <span class="cg-bar__name">@grade.Grade</span>
                                    <span class="cg-bar__value">
                                        @grade.Present / @grade.RosterSize ·
                                        @grade.PresentRate.ToString("0.#", CultureInfo.InvariantCulture)%
                                    </span>
                                </div>
                                <div class="cg-bar__track">
                                    <div class="cg-bar__fill @fill" style="width:@grade.PresentRate.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    </div>

    <div>
        @* --- Alert centre ----------------------------------------------------- *@
        <section class="cg-card" id="alerts">
            <div class="cg-card__head">
                <div>
                    <h2 class="cg-card__title">Safety alert centre</h2>
                    <div class="cg-card__sub">
                        @(Model.Alerts.Count == 0 ? "Nothing needs attention" : $"{Model.Alerts.Count} open")
                    </div>
                </div>
                @if (criticalCount > 0)
                {
                    <span class="cg-badge cg-badge--danger cg-badge--lg">
                        <span class="cg-badge__dot"></span>@criticalCount critical
                    </span>
                }
            </div>

            @if (!Model.Alerts.Any())
            {
                <div class="cg-card__body">
                    <div class="cg-empty" style="padding:28px 12px">
                        <div class="cg-empty__art" style="background:var(--cg-success-soft);color:var(--cg-success)">
                            @await Html.PartialAsync("_Icon", "shield-check")
                        </div>
                        <div class="cg-empty__title">All systems operational</div>
                        <p class="cg-empty__text">
                            No failed verifications, missing check-ins or disconnected scanners.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="cg-card__body cg-card__body--flush">
                    @foreach (var alert in Model.Alerts.Take(8))
                    {
                        <div class="cg-alertrow">
                            <span class="cg-alertrow__mark @SafetyUi.AlertMarkClass(alert.Severity)">
                                @await Html.PartialAsync("_Icon", SafetyUi.AlertIcon(alert.Severity))
                            </span>
                            <div class="cg-alertrow__body">
                                <div class="cg-alertrow__title">
                                    @alert.Title
                                    <span class="cg-badge @SafetyUi.AlertBadgeClass(alert.Severity)">@alert.Category</span>
                                </div>
                                <div class="cg-alertrow__detail">@alert.Detail</div>
                                <div class="cg-alertrow__action">
                                    <strong>Recommended:</strong> @alert.RecommendedAction
                                </div>
                                @if (!string.IsNullOrEmpty(alert.Link))
                                {
                                    <a class="cg-btn cg-btn--sm cg-btn--secondary" style="margin-top:9px" href="@alert.Link">
                                        Take action @await Html.PartialAsync("_Icon", "chevron-right")
                                    </a>
                                }
                            </div>
                            <div class="cg-alertrow__side">
                                @if (alert.OccurredAt is { } at)
                                {
                                    <span class="cg-alertrow__time" data-cg-ago="@at.ToString("O")">
                                        @at.ToSchoolTime().ToString("HH:mm")
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (Model.Alerts.Count > 8)
                {
                    <div class="cg-card__foot cg-text-sm cg-muted">
                        Showing the 8 most urgent of @Model.Alerts.Count open alerts.
                    </div>
                }
            }
        </section>

        @* --- Live activity ---------------------------------------------------- *@
        <section class="cg-card">
            <div class="cg-card__head">
                <div>
                    <h2 class="cg-card__title">Safety activity</h2>
                    <div class="cg-card__sub">Most recent checkpoints</div>
                </div>
                <span class="cg-pulse" title="Live"></span>
            </div>
            <div class="cg-card__body">
                @if (!Model.RecentActivity.Any())
                {
                    @await Html.PartialAsync("_EmptyState", ("activity", "No activity yet",
                        "Verified checkpoint scans will appear here as they happen.",
                        (string?)null, (string?)null))
                }
                else
                {
                    <ol class="cg-timeline">
                        @foreach (var e in Model.RecentActivity)
                        {
                            var marker = e.EventType switch
                            {
                                JourneyEventType.SchoolArrival => "cg-timeline__marker--success",
                                JourneyEventType.BusDropoff => "cg-timeline__marker--success",
                                JourneyEventType.SchoolDeparture => "cg-timeline__marker--warning",
                                _ => ""
                            };
                            <li class="cg-timeline__item">
                                <span class="cg-timeline__marker @marker">
                                    @await Html.PartialAsync("_Icon", SafetyUi.EventIcon(e.EventType))
                                </span>
                                <div class="cg-timeline__head">
                                    <a class="cg-timeline__title" href="/Students/Details/@e.StudentId">@e.StudentName</a>
                                    <span class="cg-timeline__time">@e.Timestamp.ToSchoolTime().ToString("HH:mm")</span>
                                </div>
                                <div class="cg-timeline__body">
                                    @SafetyUi.EventLabel(e.EventType) ·
                                    @(e.Source == EventSource.Rfid ? "RFID verification" : "Recorded by staff")
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>
            <div class="cg-card__foot">
                <a class="cg-text-sm" href="/Journey">View the full journey board</a>
            </div>
        </section>

        @* --- Verification outcome today --------------------------------------- *@
        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">Verifications today</h2>
                <span class="cg-badge cg-badge--neutral">@Model.TodaysVerificationCount attempts</span>
            </div>
            <div class="cg-card__body">
                <div class="cg-grid cg-grid--2" style="margin-bottom:0;gap:12px">
                    <div class="cg-keyvalue">
                        <span class="cg-keyvalue__key">Face matched</span>
                        <span class="cg-keyvalue__value" style="color:var(--cg-success)">@Model.TodaysVerificationStatus.Matched</span>
                    </div>
                    <div class="cg-keyvalue">
                        <span class="cg-keyvalue__key">No match</span>
                        <span class="cg-keyvalue__value" style="color:var(--cg-danger)">@Model.TodaysVerificationStatus.NoMatch</span>
                    </div>
                    <div class="cg-keyvalue">
                        <span class="cg-keyvalue__key">Handovers approved</span>
                        <span class="cg-keyvalue__value">@Model.TodaysVerificationStatus.PickupsApproved</span>
                    </div>
                    <div class="cg-keyvalue">
                        <span class="cg-keyvalue__key">Handovers rejected</span>
                        <span class="cg-keyvalue__value">@Model.TodaysVerificationStatus.PickupsRejected</span>
                    </div>
                </div>
            </div>
            <div class="cg-card__foot">
                <a class="cg-text-sm" href="/Verification/History">Open the verification log</a>
            </div>
        </section>

        @* --- Scanner health ---------------------------------------------------- *@
        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">Checkpoint scanners</h2>
                <span class="cg-badge @(transport.ScannersConnected == transport.ScannersTotal && transport.ScannersTotal > 0 ? "cg-badge--success" : "cg-badge--warning")">
                    <span class="cg-badge__dot"></span>@transport.ScannersConnected of @transport.ScannersTotal online
                </span>
            </div>
            <div class="cg-card__body">
                <p class="cg-text-sm cg-muted cg-mb-0">
                    A scanner reports online once it has sent a heartbeat or read a card.
                    Manage them from <a href="/Settings">Settings</a>.
                </p>
            </div>
        </section>
    </div>
</div>
</div>

@section Scripts {
    <script src="~/js/dashboard-live.js" asp-append-version="true"></script>
}
