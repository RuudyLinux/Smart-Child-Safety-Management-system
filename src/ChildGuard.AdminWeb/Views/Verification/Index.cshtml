@{ ViewData["Title"] = "Student Drop-off & Pickup Verification"; }
@{ var devices = (List<RfidDeviceDto>)ViewBag.Devices; var recent = (List<GuardianVerificationHistoryDto>)ViewBag.RecentVerifications; }

@* Two independent progress trackers instead of one shared 4-step pipeline — a
   drop-off scan (School Arrival / Bus Boarding) never needs guardian/face steps,
   so it should never show them as "not yet done". Only the pickup checkpoints
   (School Departure / Bus Drop-off) surface the guardian tracker. *@
<div id="dropoffStepper" class="cg-stepper">
    <div class="cg-step" id="step-scanner">1. Scanner Connected</div>
    <span class="cg-step-arrow">→</span>
    <div class="cg-step" id="step-student">2. Student Identified</div>
    <span class="cg-step-arrow">→</span>
    <div class="cg-step" id="step-event">3. Event Recorded</div>
</div>
<div id="pickupStepper" class="cg-stepper" hidden>
    <div class="cg-step" id="step-guardian">4. Guardian Verified</div>
    <span class="cg-step-arrow">→</span>
    <div class="cg-step" id="step-result">5. Pickup Approved</div>
</div>

<div class="cg-verify-grid">
<div>
    <div class="cg-card">
        <h3 class="cg-card__title">RFID Scanner</h3>
        <div class="cg-flex-between" style="margin-bottom:14px;">
            <span class="cg-muted" style="font-size:13px;">Device status</span>
            <span id="scannerStatusBadge" class="cg-badge cg-badge--neutral">Not connected</span>
        </div>
        <div class="cg-form-group">
            <label class="cg-label">Scanner Device</label>
            <select id="deviceSelect" class="cg-select">
                @foreach (var d in devices)
                {
                    <option value="@d.RfidDeviceId">@d.DeviceLabel (@d.ConnectionStatus)</option>
                }
            </select>
        </div>
        <div class="cg-form-group">
            <label class="cg-label">Logical Checkpoint</label>
            <select id="checkpointSelect" class="cg-select">
                <option value="BusBoarding">Bus Boarding (drop-off)</option>
                <option value="SchoolArrival" selected>School Arrival (drop-off)</option>
                <option value="SchoolDeparture">School Departure (pickup)</option>
                <option value="BusDropoff">Bus Drop-off (pickup)</option>
            </select>
            <p id="checkpointHint" class="cg-help">Drop-off checkpoint — scanning identifies the student and records the event. No guardian verification needed.</p>
        </div>
        <div class="cg-form-group">
            <label class="cg-label">Card UID (scan card here — reader types automatically)</label>
            <input id="cardUidInput" class="cg-input" autofocus placeholder="Waiting for scan..." />
        </div>
        <button id="scanBtn" class="cg-btn cg-btn--primary">Scan RFID Card</button>
        <button id="newScanBtn" class="cg-btn cg-btn--secondary" style="margin-left:8px;">New Scan</button>
        <p class="cg-help">Focus stays in the card field — a USB RFID reader in keyboard mode types the UID and presses Enter automatically.</p>
    </div>

    <div class="cg-card" id="studentCard" hidden>
        <h3 class="cg-card__title">Student</h3>
        <p><strong id="studentName"></strong> &nbsp; <span id="studentRfid" class="cg-muted"></span></p>
        <div id="studentMessage" aria-live="polite"></div>
    </div>
</div>

<div id="pickupCard">
    <div class="cg-card">
        <h3 class="cg-card__title">Guardian Pickup Verification</h3>
        <div class="cg-form-group">
            <label class="cg-label">Authorized Guardian</label>
            <select id="guardianSelect" class="cg-select"><option value="">Scan a student first...</option></select>
        </div>
        <div class="cg-flex-between" style="margin-bottom:10px;">
            <span class="cg-muted" style="font-size:13px;">Authorization</span>
            <span id="guardianAuthBadge" class="cg-badge cg-badge--neutral">Pending scan</span>
        </div>
        <div class="cg-camera-box" id="cameraBox">Camera not started</div>
        <canvas id="captureCanvas" hidden></canvas>
        <div class="cg-flex" style="justify-content:center;margin-bottom:12px;">
            <button id="startCameraBtn" class="cg-btn cg-btn--secondary">Start Camera</button>
            <button id="captureBtn" class="cg-btn cg-btn--primary" disabled>Capture &amp; Verify Face</button>
        </div>
        <div id="faceResult" aria-live="polite"></div>
        <div class="cg-flex" style="justify-content:center;margin-top:12px;">
            <button id="approveBtn" class="cg-btn cg-btn--success" disabled>Approve Pickup</button>
            <button id="rejectBtn" class="cg-btn cg-btn--danger" disabled>Reject</button>
        </div>
        <div id="decisionResult" aria-live="polite" style="margin-top:12px;"></div>
    </div>
</div>
</div>

<div class="cg-card">
    <h3 class="cg-card__title">Recent Verification History</h3>
    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead><tr><th>Student</th><th>Guardian</th><th>Time</th><th>Score</th><th>Result</th><th>Pickup</th></tr></thead>
            <tbody>
            @if (!recent.Any())
            {
                <tr><td colspan="6" class="cg-muted">No verification attempts yet.</td></tr>
            }
            @foreach (var v in recent)
            {
                <tr>
                    <td>@v.StudentName</td>
                    <td>@v.GuardianName</td>
                    <td>@v.AttemptedAt.ToLocalTime().ToString("g")</td>
                    <td>@v.MatchScore.ToString("0.00")</td>
                    <td>
                        @if (v.Result == VerificationResult.Match) { <span class="cg-badge cg-badge--success">Match</span> } else { <span class="cg-badge cg-badge--error">No Match</span> }
                    </td>
                    <td>
                        @if (v.PickupApproved) { <span class="cg-badge cg-badge--success">Approved</span> } else { <span class="cg-badge cg-badge--neutral">—</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="~/js/verification.js"></script>
}
