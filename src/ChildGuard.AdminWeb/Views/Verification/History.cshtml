@model ListPageViewModel<GuardianVerificationHistoryDto>
@{
    ViewData["Title"] = "Verification Log";
    var q = (ListQuery)ViewData["Query"]!;
    var students = ViewBag.Students as List<StudentListItemDto> ?? new();
    var summary = ViewBag.Summary as VerificationHistorySummaryDto;
    string Figure(int? n) => n?.ToString() ?? "–";
}

<div class="cg-page-head">
    <div class="cg-page-head__text">
        <h1 class="cg-page-head__title">Verification log</h1>
        <p class="cg-page-head__sub">
            Every pickup verification attempt, its match score, which checks passed (identity, authorisation, live person) and the handover decision that followed.
        </p>
    </div>
    <div class="cg-page-head__actions">
        <a class="cg-btn cg-btn--primary" href="/Verification">
            @await Html.PartialAsync("_Icon", "pickup") Open pickup desk
        </a>
    </div>
</div>

<div class="cg-grid cg-grid--4">
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Attempts</div>
            <span class="cg-kpi__icon">@await Html.PartialAsync("_Icon", "verification")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Figure(summary?.Total)</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Face matched</div>
            <span class="cg-kpi__icon cg-kpi__icon--success">@await Html.PartialAsync("_Icon", "user-check")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Figure(summary?.Matched)</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">No match</div>
            <span class="cg-kpi__icon @(summary?.NoMatch > 0 ? "cg-kpi__icon--danger" : "cg-kpi__icon--neutral")">
                @await Html.PartialAsync("_Icon", "user-x")
            </span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Figure(summary?.NoMatch)</div>
        <div class="cg-kpi__note">Student must not be released on a no-match</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Handovers approved</div>
            <span class="cg-kpi__icon cg-kpi__icon--info">@await Html.PartialAsync("_Icon", "check-circle")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Figure(summary?.Approved)</div>
    </article>
</div>

<section class="cg-card">
    @* Search, filters and sort run on the server; with JavaScript only the list region below is re-rendered
       and the URL keeps the view, so Back, Refresh and bookmarks restore it. *@
    <form method="get" action="/Verification/History" class="cg-toolbar" data-cg-list="list" role="search">
        <select class="cg-select" name="studentId" style="max-width:220px" data-cg-filter="studentId" aria-label="Filter by student">
            <option value="__all">All students</option>
            @foreach (var s in students)
            {
                <option value="@s.StudentId" selected="@(q.Value("studentId") == s.StudentId.ToString())">@s.FullName</option>
            }
        </select>
        <div class="cg-row" style="max-width:300px">
            <div class="cg-input-group" style="flex:1">
                <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "search")</span>
                <input class="cg-input" name="search" value="@q.Search" placeholder="Search student or guardian"
                       aria-label="Search the verification log" autocomplete="off" />
            </div>
            <button class="cg-btn cg-btn--secondary" type="submit">Search</button>
        </div>
        <select class="cg-select" style="max-width:150px" name="result" data-cg-filter="result" data-cg-filter-scope="verifications"
                aria-label="Filter by result">
            <option value="__all">Any result</option>
            <option value="Match" selected="@(q.Value("result") == "Match")">Match</option>
            <option value="NoMatch" selected="@(q.Value("result") == "NoMatch")">No match</option>
        </select>
        <select class="cg-select" style="max-width:170px" name="handover" data-cg-filter="handover" data-cg-filter-scope="verifications"
                aria-label="Filter by handover">
            <option value="__all">Any handover</option>
            <option value="approved" selected="@(q.Value("handover") == "approved")">Approved</option>
            <option value="not" selected="@(q.Value("handover") == "not")">Not approved</option>
        </select>
        <label class="cg-text-sm cg-muted">From <input class="cg-input" type="date" name="from" value="@q.Value("from")" aria-label="From date" style="max-width:150px" /></label>
        <label class="cg-text-sm cg-muted">To <input class="cg-input" type="date" name="to" value="@q.Value("to")" aria-label="To date" style="max-width:150px" /></label>
        @if (q.SortKey is not null)
        {
            <input type="hidden" name="sort" value="@q.SortKey" />
            <input type="hidden" name="dir" value="@(q.Descending ? "desc" : "asc")" />
        }
        <a class="cg-btn cg-btn--ghost cg-btn--sm" data-cg-reset data-cg-reset-scope="verifications" data-cg-list-link
           href="@q.ClearedFilters().Url()">Clear</a>
        <span class="cg-toolbar__spacer"></span>
    </form>

    @* The announcer sits outside the region: a live region replaced already filled is announced unreliably,
       so cg-ajax.js copies the new count into it. *@
    <span class="cg-sr-only" data-cg-list-status role="status" aria-live="polite"></span>
    <div data-cg-region="list">
        @if (ViewBag.LoadError is string loadError)
        {
            <div class="cg-card__body">
                <div class="cg-alert cg-alert--danger" role="alert">
                    <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
                    <div class="cg-alert__body">
                        <div>@loadError</div>
                        <a href="@q.Url(page: q.CurrentPage)" data-cg-list-link>Try again</a>
                    </div>
                </div>
            </div>
        }
        else if (Model.PastTheEnd)
        {
            <div class="cg-empty" data-cg-page-missing>
                <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                <div class="cg-empty__title">There is no page @Model.Page</div>
                <p class="cg-empty__text">This log has @Model.PageCount page@(Model.PageCount == 1 ? "" : "s") of results now.</p>
                <a class="cg-btn cg-btn--secondary cg-btn--sm" href="@q.Url(page: Model.PageCount)" data-cg-list-link>Go to page @Model.PageCount</a>
            </div>
        }
        else if (Model.Total == 0 && !q.HasFilters)
        {
            @await Html.PartialAsync("_EmptyState", ("verification", "No verification attempts recorded",
                "Attempts are logged whenever a guardian is verified at the pickup desk.",
                (string?)"Open the pickup desk", (string?)"/Verification"))
        }
        else
        {
            <div class="cg-row cg-row--between" style="padding:0 16px">
                <span class="cg-text-sm cg-muted" data-cg-count data-cg-count-scope="verifications">@Model.Total @(Model.Total == 1 ? "record" : "records")</span>
            </div>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("when", "When", q.SortKey, q.Descending, q.Url))
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("student", "Student", q.SortKey, q.Descending, q.Url))
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("guardian", "Guardian", q.SortKey, q.Descending, q.Url))
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("score", "Match score", q.SortKey, q.Descending, q.Url))
                            <th>Result</th>
                            <th>Checks</th>
                            <th>Handover</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var v in Model.Items)
                {
                    <tr data-row>

                        <td class="cg-text-sm">
                            <div>@v.AttemptedAt.ToSchoolTime().ToString("d MMM yyyy")</div>
                            <div class="cg-muted">@v.AttemptedAt.ToSchoolTime().ToString("HH:mm")</div>
                        </td>
                        <td><a href="/Students/Details/@v.StudentId">@v.StudentName</a></td>
                        <td><a href="/Guardians/Details/@v.GuardianId">@v.GuardianName</a></td>
                        <td class="cg-num">@v.MatchScore.ToString("0.00")</td>
                        <td>
                            @if (v.Result == VerificationResult.Match)
                            {
                                <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>Match</span>
                            }
                            else
                            {
                                <span class="cg-badge cg-badge--danger"><span class="cg-badge__dot"></span>No match</span>
                            }
                        </td>
                        <td><partial name="_VerificationChecks" model="v" /></td>
                        <td>
                            <partial name="_PickupStateBadge" model="v" />
                        </td>
                    </tr>
                }
                    </tbody>
                </table>
            </div>

            @if (Model.Total == 0)
            {
                <div class="cg-empty" data-cg-noresults data-cg-noresults-scope="verifications">
                    <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                    <div class="cg-empty__title">No attempts match these filters</div>
                    <p class="cg-empty__text">Clear one or more filters to widen the log.</p>
                </div>
            }

            @await Html.PartialAsync("_Pager", new PagerModel("verifications", Model.Page, Model.PageCount, Model.FirstRow, Model.LastRow, Model.Total, "attempts", p => q.Url(page: p)))
        }
    </div>
</section>
