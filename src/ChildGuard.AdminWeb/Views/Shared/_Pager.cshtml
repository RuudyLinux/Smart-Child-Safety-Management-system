@model PagerModel
<nav class="cg-pagination" aria-label="Pages">
    <span class="cg-text-sm">
        @if (Model.Total == 0)
        {
            @:No @Model.Noun
        }
        else
        {
            @:Showing @Model.FirstRow–@Model.LastRow of @Model.Total @Model.Noun
        }
    </span>
    <div class="cg-pagination__pages" data-cg-pager data-cg-pager-scope="@Model.Scope">
        @foreach (var p in Model.Pages)
        {
            if (p == 0)
            {
                <span class="cg-pagination__gap" aria-hidden="true">…</span>
            }
            else
            {
                <a class="cg-pagination__btn @(p == Model.Page ? "is-active" : "")" href="@Model.Url(p)" data-cg-list-link
                   aria-label="Page @p" aria-current="@(p == Model.Page ? "page" : null)">@p</a>
            }
        }
    </div>
</nav>
