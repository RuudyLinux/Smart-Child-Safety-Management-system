@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string c) => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase);
    string NavClass(string c) => IsActive(c) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — ChildGuard Admin</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="cg-app">
        <aside class="cg-sidebar">
            <div class="cg-sidebar__brand">Child<span>Guard</span></div>
            <ul class="cg-nav">
                <li><a class="@NavClass("Dashboard")" href="/Dashboard">@await Html.PartialAsync("_Icon", "dashboard") Dashboard</a></li>
                <li class="cg-nav__section">Records</li>
                <li><a class="@NavClass("Students")" href="/Students">@await Html.PartialAsync("_Icon", "students") Students</a></li>
                <li><a class="@NavClass("Rfid")" href="/Rfid">@await Html.PartialAsync("_Icon", "rfid") RFID</a></li>
                <li><a class="@NavClass("Guardians")" href="/Guardians">@await Html.PartialAsync("_Icon", "guardians") Guardians</a></li>
                <li><a class="@NavClass("Transportation")" href="/Transportation">@await Html.PartialAsync("_Icon", "transportation") Transportation</a></li>
                <li class="cg-nav__section">Operations</li>
                <li><a class="@NavClass("Attendance")" href="/Attendance">@await Html.PartialAsync("_Icon", "attendance") Attendance</a></li>
                <li><a class="@NavClass("Journey")" href="/Journey">@await Html.PartialAsync("_Icon", "journey") Journey</a></li>
                <li><a class="@NavClass("Verification")" href="/Verification">@await Html.PartialAsync("_Icon", "verification") Drop-off &amp; Pickup</a></li>
                <li class="cg-nav__section">Insights</li>
                <li><a class="@NavClass("Reports")" href="/Reports">@await Html.PartialAsync("_Icon", "reports") Reports</a></li>
                <li class="cg-nav__section">Account</li>
                <li><a class="@NavClass("Profile")" href="/Profile">@await Html.PartialAsync("_Icon", "profile") Profile</a></li>
                <li><a class="@NavClass("Settings")" href="/Settings">@await Html.PartialAsync("_Icon", "settings") Settings</a></li>
                <li><a href="/Account/Logout">@await Html.PartialAsync("_Icon", "logout") Logout</a></li>
            </ul>
        </aside>
        <div class="cg-main">
            <header class="cg-header">
                <div class="cg-flex">
                    <button type="button" class="cg-menu-btn" id="cgMenuBtn" aria-label="Toggle navigation">☰</button>
                    <div class="cg-header__title">@ViewData["Title"]</div>
                </div>
                <div class="cg-header__user">
                    <span>@User.Identity!.Name</span>
                    <span class="cg-badge cg-badge--neutral">Admin</span>
                </div>
            </header>
            <main class="cg-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script>
        document.getElementById('cgMenuBtn')?.addEventListener('click', function () {
            document.querySelector('.cg-sidebar').classList.toggle('cg-sidebar--open');
        });
    </script>
}
else
{
    @RenderBody()
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
