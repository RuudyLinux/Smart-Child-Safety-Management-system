@model ListPageViewModel<RfidCardListItemDto>
@{
    ViewData["Title"] = "RFID Cards";
    var q = (ListQuery)ViewData["Query"]!;
    var summary = ViewBag.Summary as RfidCardSummaryDto;
    var unassignedStudents = (List<StudentListItemDto>)ViewBag.UnassignedStudents;
    var devices = ViewBag.Devices as List<RfidDeviceDto> ?? new();
    string Figure(int? n) => n?.ToString() ?? "–";
}

<div data-cg-region="rfid-console">
<div class="cg-page-head">
    <div class="cg-page-head__text">
        <h1 class="cg-page-head__title">RFID Cards</h1>
        <p class="cg-page-head__sub">
            @Figure(summary?.Total) card@(summary?.Total == 1 ? "" : "s") registered · @Figure(summary?.Active) active ·
            @unassignedStudents.Count student@(unassignedStudents.Count == 1 ? "" : "s") still without one
        </p>
    </div>
    <div class="cg-page-head__actions">
        <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-open="registerCardModal">
            @await Html.PartialAsync("_Icon", "scan") Register spare card
        </button>
        @if (unassignedStudents.Any())
        {
            <button type="button" class="cg-btn cg-btn--primary" data-cg-modal-open="assignCardModal">
                @await Html.PartialAsync("_Icon", "plus") Assign card
            </button>
        }
    </div>
</div>

<div class="cg-grid cg-grid--4">
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Active cards</div>
            <span class="cg-kpi__icon cg-kpi__icon--success">@await Html.PartialAsync("_Icon", "rfid")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Figure(summary?.Active)</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Available cards</div>
            <span class="cg-kpi__icon cg-kpi__icon--neutral">@await Html.PartialAsync("_Icon", "id-card")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Figure(summary?.AvailableSpare)</div>
        <div class="cg-kpi__note">Active and not linked to a student (@Figure(summary?.Unassigned) unassigned in total)</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Lost or damaged</div>
            <span class="cg-kpi__icon @(summary?.LostOrDamaged > 0 ? "cg-kpi__icon--danger" : "cg-kpi__icon--neutral")">
                @await Html.PartialAsync("_Icon", "alert-triangle")
            </span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Figure(summary?.LostOrDamaged)</div>
        <div class="cg-kpi__note">Blocked from recording checkpoints</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Scanners online</div>
            <span class="cg-kpi__icon cg-kpi__icon--info">@await Html.PartialAsync("_Icon", "scan")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">
            @devices.Count(d => d.ConnectionStatus == RfidConnectionStatus.Connected)
            <span class="cg-kpi__unit">/ @devices.Count</span>
        </div>
        <div class="cg-kpi__note"><a href="/Settings">Manage devices</a></div>
    </article>
</div>

@if (!unassignedStudents.Any() && summary?.Total > 0)
{
    <div class="cg-alert cg-alert--success">
        <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "check-circle")</span>
        <div class="cg-alert__body">
            <div class="cg-alert__title">Every student has a card</div>
            <div>All active students can be identified at a checkpoint.</div>
        </div>
    </div>
}


<section class="cg-card">
    @* Search, filters and sort run on the server; with JavaScript only the list region below is re-rendered
       and the URL keeps the view, so Back, Refresh and bookmarks restore it. *@
    <form method="get" action="/Rfid" class="cg-toolbar" data-cg-list="list" role="search">
        <div class="cg-row cg-toolbar__grow" style="max-width:380px">
            <div class="cg-input-group" style="flex:1">
                <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "search")</span>
                <input class="cg-input" name="search" value="@q.Search" placeholder="Search card or student"
                       aria-label="Search RFID cards" autocomplete="off" />
            </div>
            <button class="cg-btn cg-btn--secondary" type="submit">Search</button>
        </div>
        <select class="cg-select" style="max-width:150px" name="state" data-cg-filter="state" data-cg-filter-scope="rfid"
                aria-label="Filter by card status">
            <option value="__all">Any status</option>
            @foreach (var s in new[] { "Active", "Inactive", "Lost", "Damaged", "Retired" })
            {
                <option value="@s" selected="@(q.Value("state") == s)">@s</option>
            }
        </select>
        <select class="cg-select" style="max-width:170px" name="assigned" data-cg-filter="assigned" data-cg-filter-scope="rfid"
                aria-label="Filter by assignment">
            <option value="__all">Any assignment</option>
            <option value="yes" selected="@(q.Value("assigned") == "yes")">Assigned to a student</option>
            <option value="no" selected="@(q.Value("assigned") == "no")">Unassigned</option>
        </select>
        @if (q.SortKey is not null)
        {
            <input type="hidden" name="sort" value="@q.SortKey" />
            <input type="hidden" name="dir" value="@(q.Descending ? "desc" : "asc")" />
        }
        <a class="cg-btn cg-btn--ghost cg-btn--sm" data-cg-reset data-cg-reset-scope="rfid" data-cg-list-link
           href="@q.ClearedFilters().Url()">Clear</a>
        <span class="cg-toolbar__spacer"></span>
    </form>

    @* The announcer sits outside the region: a live region replaced already filled is announced unreliably,
       so cg-ajax.js copies the new count into it. *@
    <span class="cg-sr-only" data-cg-list-status role="status" aria-live="polite"></span>
    <div data-cg-region="list">
        @if (ViewBag.LoadError is string listError)
        {
            <div class="cg-card__body">
                <div class="cg-alert cg-alert--danger" role="alert">
                    <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
                    <div class="cg-alert__body">
                        <div>@listError</div>
                        <a href="@q.Url(page: q.CurrentPage)" data-cg-list-link>Try again</a>
                    </div>
                </div>
            </div>
        }
        else if (Model.PastTheEnd)
        {
            <div class="cg-empty" data-cg-page-missing>
                <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                <div class="cg-empty__title">There is no page @Model.Page</div>
                <p class="cg-empty__text">This list has @Model.PageCount page@(Model.PageCount == 1 ? "" : "s") of results now.</p>
                <a class="cg-btn cg-btn--secondary cg-btn--sm" href="@q.Url(page: Model.PageCount)" data-cg-list-link>Go to page @Model.PageCount</a>
            </div>
        }
        else if (Model.Total == 0 && !q.HasFilters)
        {
            @await Html.PartialAsync("_EmptyState", ("rfid", "No RFID cards registered",
                "Scan a card at any reader to capture its UID, then assign it to a student.",
                (string?)null, (string?)null))
            @if (unassignedStudents.Any())
            {
                <div style="text-align:center;margin-top:-12px">
                    <button type="button" class="cg-btn cg-btn--primary" data-cg-modal-open="assignCardModal">Assign the first card</button>
                </div>
            }
        }
        else
        {
            <div class="cg-row cg-row--between" style="padding:0 16px">
                <span class="cg-text-sm cg-muted" data-cg-count data-cg-count-scope="rfid">@Model.Total @(Model.Total == 1 ? "record" : "records")</span>
            </div>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            <th>Card</th>
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("student", "Assigned student", q.SortKey, q.Descending, q.Url))
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("status", "Status", q.SortKey, q.Descending, q.Url))
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("assigned", "Assigned on", q.SortKey, q.Descending, q.Url))
                            <th>Change status</th>
                            <th class="cg-table__actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var c in Model.Items)
                {
                    var badge = c.Status switch
                    {
                        RfidCardStatus.Active => "cg-badge--success",
                        RfidCardStatus.Lost or RfidCardStatus.Damaged => "cg-badge--danger",
                        _ => "cg-badge--neutral"
                    };
                    <tr data-row>

                        <td>
                            <span class="cg-row">
                                @await Html.PartialAsync("_Icon", "id-card")
                                <span class="cg-mono">@c.MaskedCardUid</span>
                            </span>
                        </td>
                        <td>
                            @if (c.StudentId is null)
                            {
                                <span class="cg-badge cg-badge--neutral">Unassigned</span>
                            }
                            else
                            {
                                <a href="/Students/Details/@c.StudentId">@c.StudentName</a>
                            }
                        </td>
                        <td><span class="cg-badge @badge"><span class="cg-badge__dot"></span>@c.Status</span></td>
                        <td class="cg-text-sm cg-muted">
                            @(c.AssignedAt?.ToSchoolTime().ToString("d MMM yyyy") ?? "—")
                        </td>
                        <td>
                            <form data-cg-ajax asp-action="UpdateStatus" asp-route-id="@c.RfidCardId" method="post" class="cg-row">
                                @Html.AntiForgeryToken()
                                <select class="cg-select" name="status" style="max-width:120px"
                                        aria-label="Status for card @c.MaskedCardUid">
                                    <option value="Active" selected="@(c.Status == RfidCardStatus.Active)">Active</option>
                                    <option value="Inactive" selected="@(c.Status == RfidCardStatus.Inactive)">Inactive</option>
                                    <option value="Lost" selected="@(c.Status == RfidCardStatus.Lost)">Lost</option>
                                    <option value="Damaged" selected="@(c.Status == RfidCardStatus.Damaged)">Damaged</option>
                                    <option value="Retired" selected="@(c.Status == RfidCardStatus.Retired)">Retired</option>
                                </select>
                                <button class="cg-btn cg-btn--secondary cg-btn--sm" type="submit">Update</button>
                            </form>
                        </td>
                        <td class="cg-table__actions">
                            <span class="cg-table__row-actions">
                                <a class="cg-btn cg-btn--sm cg-btn--ghost cg-btn--icon" href="/Rfid/Details/@c.RfidCardId"
                                   title="Card details" aria-label="Details for card @c.MaskedCardUid">
                                    @await Html.PartialAsync("_Icon", "eye")
                                </a>
                            </span>
                        </td>
                    </tr>
                }
                    </tbody>
                </table>
            </div>

            @if (Model.Total == 0)
            {
                <div class="cg-empty" data-cg-noresults data-cg-noresults-scope="rfid">
                    <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                    <div class="cg-empty__title">No cards match these filters</div>
                    <p class="cg-empty__text">Clear one or more filters, or try a different search.</p>
                </div>
            }

            <div class="cg-text-sm cg-muted" style="padding:0 16px">Only the last four characters of a card UID are ever shown.</div>
            @await Html.PartialAsync("_Pager", new PagerModel("rfid", Model.Page, Model.PageCount, Model.FirstRow, Model.LastRow, Model.Total, "cards", p => q.Url(page: p)))
        }
    </div>
</section>
<div class="cg-modal" id="assignCardModal" hidden role="dialog" aria-modal="true" aria-labelledby="assignCardTitle">
    <div class="cg-modal__panel">
        <div class="cg-modal__head">
            <div>
                <h2 class="cg-modal__title" id="assignCardTitle">Assign an RFID card</h2>
                <div class="cg-modal__sub">Hold the card against a reader — it types the UID into the field.</div>
            </div>
            <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">
                @await Html.PartialAsync("_Icon", "x")
            </button>
        </div>

        <form data-cg-ajax asp-action="Assign" method="post" data-cg-busy>
            @Html.AntiForgeryToken()
            <div class="cg-modal__body">
                <div class="cg-form">
                    <div class="cg-field">
                        <label class="cg-label" for="cardUid">Card UID <span class="cg-label__req">*</span></label>
                        <div class="cg-input-group">
                            <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "scan")</span>
                            <input class="cg-input cg-mono" id="cardUid" name="cardUid" required
                                   maxlength="100" placeholder="Waiting for a scan…" autocomplete="off" />
                        </div>
                        <p class="cg-hint">
                            A USB reader in keyboard mode types the UID automatically while this field is focused.
                        </p>
                    </div>
                    <div class="cg-field">
                        <label class="cg-label" for="assignStudentId">Student <span class="cg-label__req">*</span></label>
                        <select class="cg-select" id="assignStudentId" name="studentId" required>
                            @foreach (var s in unassignedStudents)
                            {
                                <option value="@s.StudentId">@s.FullName@(string.IsNullOrEmpty(s.Grade) ? "" : $" — {s.Grade}")</option>
                            }
                        </select>
                        <p class="cg-hint">Only students without a card are listed.</p>
                    </div>
                </div>
            </div>
            <div class="cg-modal__foot">
                <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Assign card</span></button>
            </div>
        </form>
    </div>
</div>

<div class="cg-modal" id="registerCardModal" hidden role="dialog" aria-modal="true" aria-labelledby="registerCardTitle">
    <div class="cg-modal__panel">
        <div class="cg-modal__head">
            <div>
                <h2 class="cg-modal__title" id="registerCardTitle">Register a spare card</h2>
                <div class="cg-modal__sub">Adds the card to the inventory without giving it to anyone. Assign it later from its page or during enrollment.</div>
            </div>
            <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">@await Html.PartialAsync("_Icon", "x")</button>
        </div>
        <form data-cg-ajax asp-action="Register" method="post" data-cg-busy>
            @Html.AntiForgeryToken()
            <div class="cg-modal__body">
                <div class="cg-field">
                    <label class="cg-label" for="registerUid">Card UID <span class="cg-label__req">*</span></label>
                    <div class="cg-input-group">
                        <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "scan")</span>
                        <input class="cg-input cg-mono" id="registerUid" name="cardUid" required maxlength="100" placeholder="Waiting for a scan…" autocomplete="off" />
                    </div>
                    <p class="cg-hint">A USB reader in keyboard mode types the UID and presses Enter, which registers the card.</p>
                </div>
            </div>
            <div class="cg-modal__foot">
                <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Register card</span></button>
            </div>
        </form>
    </div>
</div>
</div>
