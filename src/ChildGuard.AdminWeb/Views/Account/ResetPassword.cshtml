@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}
<div class="cg-login-wrap">
    <div class="cg-login-card">
        <h1>Reset Password</h1>
        <p>Enter the reset token you received and choose a new password.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="cg-alert cg-alert--error">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="cg-alert cg-alert--success">@Model.SuccessMessage <a asp-action="Login">Sign in</a></div>
        }

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="cg-form-group">
                <label class="cg-label" asp-for="Email">Email</label>
                <input class="cg-input" asp-for="Email" autocomplete="username" />
                <span class="cg-error-text" asp-validation-for="Email"></span>
            </div>
            <div class="cg-form-group">
                <label class="cg-label" asp-for="ResetToken">Reset Token</label>
                <input class="cg-input" asp-for="ResetToken" />
                <span class="cg-error-text" asp-validation-for="ResetToken"></span>
            </div>
            <div class="cg-form-group">
                <label class="cg-label" asp-for="NewPassword">New Password</label>
                <input class="cg-input" asp-for="NewPassword" autocomplete="new-password" />
                <span class="cg-error-text" asp-validation-for="NewPassword"></span>
            </div>
            <button type="submit" class="cg-btn cg-btn--primary" style="width:100%;justify-content:center;">Reset Password</button>
        </form>
        <p style="text-align:center;margin:16px 0 0;"><a asp-action="Login">Back to sign in</a></p>
    </div>
</div>
