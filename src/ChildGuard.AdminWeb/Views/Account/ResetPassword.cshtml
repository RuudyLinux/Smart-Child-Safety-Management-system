@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Set a new password";
    Layout = "_Layout";
}

<div class="cg-auth">
    <section class="cg-auth__brandside">
        <div class="cg-auth__logo">
            <span class="cg-brand__mark">@await Html.PartialAsync("_Icon", "shield-check")</span>
            <span class="cg-auth__logo-name">Child<span>Guard</span></span>
        </div>
        <div class="cg-auth__pitch">
            <h1 class="cg-auth__headline">Choose a password only you know.</h1>
            <p class="cg-auth__lede">
                Reset tokens are single-use and expire, so a token that has already been
                used or has aged out will be refused.
            </p>
        </div>
        <p class="cg-auth__foot">Administrator console · Authorised school staff only</p>
    </section>

    <section class="cg-auth__formside">
        <div class="cg-auth__card">
            <div class="cg-auth__mobilelogo">
                <span class="cg-brand__mark">@await Html.PartialAsync("_Icon", "shield-check")</span>
                <span class="cg-auth__logo-name" style="color:var(--cg-text)">Child<span style="color:var(--cg-primary)">Guard</span></span>
            </div>

            <h1 class="cg-auth__title">Reset password</h1>
            <p class="cg-auth__subtitle">Enter the token you received and choose a new password.</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="cg-alert cg-alert--danger" role="alert">
                    <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
                    <div class="cg-alert__body">@Model.ErrorMessage</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="cg-alert cg-alert--success" role="status">
                    <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "check-circle")</span>
                    <div class="cg-alert__body">
                        <div class="cg-alert__title">Password updated</div>
                        <div>@Model.SuccessMessage <a asp-action="Login">Sign in now</a>.</div>
                    </div>
                </div>
            }

            <form asp-action="ResetPassword" method="post" class="cg-form" data-cg-busy>
                @Html.AntiForgeryToken()

                <div class="cg-field">
                    <label class="cg-label" asp-for="Email">Email address</label>
                    <div class="cg-input-group">
                        <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "mail")</span>
                        <input class="cg-input" asp-for="Email" type="email" autocomplete="username" required />
                    </div>
                    <span class="cg-error-text" asp-validation-for="Email"></span>
                </div>

                <div class="cg-field">
                    <label class="cg-label" asp-for="ResetToken">Reset token</label>
                    <div class="cg-input-group">
                        <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "key")</span>
                        <input class="cg-input cg-mono" asp-for="ResetToken" autocomplete="one-time-code" required />
                    </div>
                    <span class="cg-error-text" asp-validation-for="ResetToken"></span>
                </div>

                <div class="cg-field">
                    <label class="cg-label" asp-for="NewPassword">New password</label>
                    <div class="cg-input-group cg-input-group--action">
                        <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "lock")</span>
                        <input class="cg-input" asp-for="NewPassword" type="password" id="NewPassword"
                               autocomplete="new-password" minlength="8" required />
                        <button type="button" class="cg-input-group__action" data-cg-reveal="NewPassword"
                                aria-label="Show password" aria-pressed="false">
                            @await Html.PartialAsync("_Icon", "eye")
                        </button>
                    </div>
                    <p class="cg-hint">At least 8 characters, including one uppercase letter and one digit.</p>
                    <span class="cg-error-text" asp-validation-for="NewPassword"></span>
                </div>

                <button type="submit" class="cg-btn cg-btn--primary cg-btn--lg cg-btn--block">
                    <span class="cg-btn__label">Reset password</span>
                </button>
            </form>

            <p class="cg-auth__legal"><a asp-action="Login">Back to sign in</a></p>
        </div>
    </section>
</div>
