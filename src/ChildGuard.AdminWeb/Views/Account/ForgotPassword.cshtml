@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}
<div class="cg-login-wrap">
    <div class="cg-login-card">
        <h1>Forgot Password</h1>
        <p>Enter your admin email and we'll send a reset token.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="cg-alert cg-alert--error">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="cg-alert cg-alert--success">@Model.InfoMessage</div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="cg-form-group">
                <label class="cg-label" asp-for="Email">Email</label>
                <input class="cg-input" asp-for="Email" autocomplete="username" />
                <span class="cg-error-text" asp-validation-for="Email"></span>
            </div>
            <button type="submit" class="cg-btn cg-btn--primary" style="width:100%;justify-content:center;">Send Reset Token</button>
        </form>
        <p style="text-align:center;margin:16px 0 0;">
            <a asp-action="ResetPassword">Have a reset token?</a> &nbsp;·&nbsp; <a asp-action="Login">Back to sign in</a>
        </p>
    </div>
</div>
