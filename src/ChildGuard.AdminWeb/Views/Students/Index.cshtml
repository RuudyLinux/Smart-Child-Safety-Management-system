@model ListPageViewModel<StudentListItemDto>
@{
    ViewData["Title"] = "Students";
    var grades = ViewBag.Grades as List<string> ?? new List<string>();
    var q = (StudentListQuery)ViewData["Query"]!;
    var figures = ViewBag.Figures as StudentListFigures;
    var search = q.Search?.Trim();

}

<div class="cg-page-head">
    <div class="cg-page-head__text">
        <h1 class="cg-page-head__title">Students</h1>
        <p class="cg-page-head__sub">
            @(figures?.OnRoll?.ToString() ?? "–") on roll · @(figures?.PresentToday?.ToString() ?? "–") checked in today · @(figures?.WithRfid?.ToString() ?? "–") carrying an RFID card
        </p>
    </div>
    <div class="cg-page-head__actions">
        <a class="cg-btn cg-btn--secondary" href="/Reports">@await Html.PartialAsync("_Icon", "reports") Reports</a>
        <a class="cg-btn cg-btn--secondary" href="/Students/Create" title="Create the student record only">Add student</a>
        <a class="cg-btn cg-btn--primary" href="/Enrollment">@await Html.PartialAsync("_Icon", "plus") Enroll New Student</a>
    </div>
</div>

@if (figures?.WithoutGuardian is > 0 and var noGuardian)
{
    <div class="cg-alert cg-alert--warning">
        <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-triangle")</span>
        <div class="cg-alert__body">
            <div class="cg-alert__title">@noGuardian student@(noGuardian == 1 ? " has" : "s have") no linked guardian</div>
            <div>Nobody can be verified to collect them until a guardian is linked and authorised for pickup.</div>
        </div>
    </div>
}

<section class="cg-card">
    @* Filters, search and sort run on the server; with JavaScript only the list region below is
       re-rendered and the URL keeps the view, so Back, Refresh and bookmarks restore it. *@
    <form method="get" action="/Students" class="cg-toolbar" data-cg-list="list" role="search">
        <div class="cg-row" style="flex:1;min-width:220px;max-width:340px">
            <div class="cg-input-group" style="flex:1">
                <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "search")</span>
                <input class="cg-input" name="search" value="@search" placeholder="Search all students by name"
                       aria-label="Search students by name" autocomplete="off" />
            </div>
            <button class="cg-btn cg-btn--secondary" type="submit">Search</button>
        </div>

        <select class="cg-select" style="max-width:150px" name="grade" data-cg-filter="grade" data-cg-filter-scope="students"
                aria-label="Filter by grade">
            <option value="__all">All grades</option>
            @foreach (var grade in grades)
            {
                <option value="@grade" selected="@string.Equals(q.Grade, grade, StringComparison.OrdinalIgnoreCase)">@grade</option>
            }
        </select>

        <select class="cg-select" style="max-width:170px" name="attendance" data-cg-filter="attendance" data-cg-filter-scope="students"
                aria-label="Filter by today's attendance">
            <option value="__all">Any attendance</option>
            <option value="present" selected="@(q.Attendance == "present")">Present today</option>
            <option value="absent" selected="@(q.Attendance == "absent")">Not checked in</option>
        </select>

        <select class="cg-select" style="max-width:150px" name="rfid" data-cg-filter="rfid" data-cg-filter-scope="students"
                aria-label="Filter by RFID card">
            <option value="__all">Any RFID</option>
            <option value="assigned" selected="@(q.Rfid == "assigned")">Card assigned</option>
            <option value="none" selected="@(q.Rfid == "none")">No card</option>
        </select>

        <select class="cg-select" style="max-width:160px" name="guardian" data-cg-filter="guardian" data-cg-filter-scope="students"
                aria-label="Filter by guardian">
            <option value="__all">Any guardian</option>
            <option value="linked" selected="@(q.Guardian == "linked")">Has a guardian</option>
            <option value="none" selected="@(q.Guardian == "none")">No guardian</option>
        </select>

        <select class="cg-select" style="max-width:150px" name="status" data-cg-filter="status" data-cg-filter-scope="students"
                aria-label="Filter by record status">
            <option value="__all">Any status</option>
            <option value="Active" selected="@(q.Status == "Active")">Active</option>
            <option value="Inactive" selected="@(q.Status == "Inactive")">Inactive</option>
            <option value="Archived" selected="@(q.Status == "Archived")">Archived</option>
        </select>

        @if (q.SortKey is not null)
        {
            <input type="hidden" name="sort" value="@q.SortKey" />
            <input type="hidden" name="dir" value="@(q.Descending ? "desc" : "asc")" />
        }

        @* Clears the filters, keeps the name search (as before). *@
        <a class="cg-btn cg-btn--ghost cg-btn--sm" data-cg-reset data-cg-reset-scope="students" data-cg-list-link
           href="@(new StudentListQuery { Search = search }.Url())">Clear</a>
    </form>

    <div data-cg-region="list">
        @if (ViewBag.LoadError is string loadError)
        {
            <div class="cg-card__body">
                <div class="cg-alert cg-alert--danger" role="alert">
                    <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
                    <div class="cg-alert__body">
                        <div>@loadError</div>
                        <a href="@q.Url(page: q.CurrentPage)" data-cg-list-link>Try again</a>
                    </div>
                </div>
            </div>
        }
        else if (Model.PastTheEnd)
        {
            <div class="cg-empty" data-cg-page-missing>
                <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                <div class="cg-empty__title">There is no page @Model.Page</div>
                <p class="cg-empty__text">This list has @Model.PageCount page@(Model.PageCount == 1 ? "" : "s") of results now.</p>
                <a class="cg-btn cg-btn--secondary cg-btn--sm" href="@q.Url(page: Model.PageCount)" data-cg-list-link>Go to page @Model.PageCount</a>
            </div>
        }
        else if (Model.Total == 0 && !q.HasFilters)
        {
            @await Html.PartialAsync("_EmptyState", ("students", "No students yet",
                "Add your first student, then assign an RFID card and link a guardian.",
                (string?)"Add student", (string?)"/Students/Create"))
        }
        else
        {
            <div class="cg-row cg-row--between" style="padding:0 16px">
                <span class="cg-text-sm cg-muted" data-cg-count data-cg-count-scope="students" role="status" aria-live="polite">@Model.Total @(Model.Total == 1 ? "record" : "records")</span>
            </div>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("name", "Student", q.SortKey, q.Descending, q.Url))
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("grade", "Grade", q.SortKey, q.Descending, q.Url))
                            <th>RFID</th>
                            <th>Guardian</th>
                            <th>Today</th>
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("activity", "Last activity", q.SortKey, q.Descending, q.Url))
                            <th>Safety status</th>
                            <th class="cg-table__actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var s in Model.Items)
                {
                    var photoUrl = s.HasPhoto ? Url.Action("Photo", "Students", new { id = s.StudentId }) : null;
                    <tr data-row>

                        <td>
                            <a class="cg-identity" href="/Students/Details/@s.StudentId" style="color:inherit">
                                @await Html.PartialAsync("_Avatar", new AvatarModel(photoUrl, s.FullName, "sm", false, false,
                                    SafetyUi.DotColor(s.SafetyStatus), SafetyUi.Label(s.SafetyStatus)))
                                <span class="cg-identity__body">
                                    <span class="cg-identity__name">@s.FullName</span>
                                    <span class="cg-identity__meta">
                                        @if (s.ArchivedAt is not null)
                                        {
                                            <span class="cg-badge cg-badge--warning">Archived</span>
                                        }
                                        else if (s.Status != RecordStatus.Active)
                                        {
                                            <span class="cg-badge cg-badge--neutral">Inactive</span>
                                        }
                                        else
                                        {
                                            @($"Student #{s.StudentId}")
                                        }
                                    </span>
                                </span>
                            </a>
                        </td>
                        <td>@(s.Grade ?? "—")</td>
                        <td>
                            @if (s.MaskedRfid is null)
                            {
                                <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>Not assigned</span>
                            }
                            else
                            {
                                <span class="cg-mono cg-text-sm">@s.MaskedRfid</span>
                            }
                        </td>
                        <td>
                            @if (s.GuardianCount == 0)
                            {
                                <span class="cg-badge cg-badge--danger"><span class="cg-badge__dot"></span>None linked</span>
                            }
                            else
                            {
                                <span>@s.PrimaryGuardianName</span>
                                @if (s.GuardianCount > 1)
                                {
                                    <span class="cg-tag" style="margin-left:6px">+@(s.GuardianCount - 1)</span>
                                }
                            }
                        </td>
                        <td>
                            @if (s.PresentToday && s.CheckInTime is { } checkIn)
                            {
                                <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>In @checkIn.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="cg-badge cg-badge--neutral"><span class="cg-badge__dot"></span>Not checked in</span>
                            }
                        </td>
                        <td class="cg-text-sm cg-muted">
                            @if (s.LastEventAt is { } lastAt)
                            {
                                <span data-cg-ago="@lastAt.ToString("O")">@lastAt.ToSchoolTime().ToString("HH:mm")</span>
                                <div>@SafetyUi.EventLabel(s.LastEventType)</div>
                            }
                            else
                            {
                                <span>No activity today</span>
                            }
                        </td>
                        <td>@await Html.PartialAsync("_SafetyChip", s.SafetyStatus)</td>
                        <td class="cg-table__actions">
                            <span class="cg-table__row-actions">
                                <a class="cg-btn cg-btn--sm cg-btn--ghost cg-btn--icon" href="/Students/Details/@s.StudentId"
                                   title="View profile" aria-label="View @s.FullName">
                                    @await Html.PartialAsync("_Icon", "eye")
                                </a>
                                <a class="cg-btn cg-btn--sm cg-btn--ghost cg-btn--icon" href="/Students/Edit/@s.StudentId"
                                   title="Edit" aria-label="Edit @s.FullName">
                                    @await Html.PartialAsync("_Icon", "edit")
                                </a>
                                <a class="cg-btn cg-btn--sm cg-btn--ghost cg-btn--icon" href="/Journey/Student/@s.StudentId"
                                   title="Journey" aria-label="Journey for @s.FullName">
                                    @await Html.PartialAsync("_Icon", "journey")
                                </a>
                            </span>
                        </td>
                    </tr>
                }

                    </tbody>
                </table>
            </div>

            @if (Model.Total == 0)
            {
                <div class="cg-empty" data-cg-noresults data-cg-noresults-scope="students">
                    <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                    <div class="cg-empty__title">No students match these filters</div>
                    <p class="cg-empty__text">Clear one or more filters, or try a different name.</p>
                </div>
            }

            @await Html.PartialAsync("_Pager", new PagerModel("students", Model.Page, Model.PageCount, Model.FirstRow, Model.LastRow, Model.Total, "students", p => q.Url(page: p)))
        }
    </div>
</section>