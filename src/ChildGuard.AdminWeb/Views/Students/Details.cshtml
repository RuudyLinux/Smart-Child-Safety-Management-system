@model StudentDetailDto
@using System.Globalization
@{
    ViewData["Title"] = Model.FullName;
    var availableGuardians = (List<GuardianListItemDto>)ViewBag.AvailableGuardians;
    var photoUrl = Model.HasPhoto ? Url.Action("Photo", "Students", new { id = Model.StudentId, v = Model.PhotoUpdatedAt?.Ticks }) : null;
    var age = (int)((DateTime.Today - Model.DateOfBirth).TotalDays / 365.2425);
    var stats = Model.AttendanceStats;
    var authorisedCount = Model.Guardians.Count(g => g.IsAuthorizedForPickup);
}

<div class="cg-page-head">
    <div class="cg-page-head__text">
        <nav class="cg-breadcrumb" style="margin-bottom:6px">
            <a href="/Students">@await Html.PartialAsync("_Icon", "arrow-left") Back to students</a>
        </nav>
    </div>
</div>

<section class="cg-profile">
    @await Html.PartialAsync("_Avatar", new AvatarModel(photoUrl, Model.FullName, "2xl", false, true,
        SafetyUi.DotColor(Model.SafetyStatus), SafetyUi.Label(Model.SafetyStatus)))

    <div class="cg-profile__main">
        <h1 class="cg-profile__name">@Model.FullName</h1>
        <div class="cg-profile__meta">
            @await Html.PartialAsync("_SafetyChip", Model.SafetyStatus)
            <span class="cg-tag">@(Model.Grade ?? "No grade")</span>
            @if (Model.Status == RecordStatus.Active)
            {
                <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>Active record</span>
            }
            else
            {
                <span class="cg-badge cg-badge--neutral"><span class="cg-badge__dot"></span>Inactive record</span>
            }
            @if (Model.MaskedRfid is null)
            {
                <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>No RFID card</span>
            }
            else
            {
                <span class="cg-badge cg-badge--primary">@await Html.PartialAsync("_Icon", "rfid") @Model.MaskedRfid</span>
            }
        </div>

        <div class="cg-profile__facts">
            <div class="cg-keyvalue">
                <span class="cg-keyvalue__key">Checked in today</span>
                <span class="cg-keyvalue__value">
                    @(Model.PresentToday && Model.CheckInTime is { } t ? t.ToString("HH:mm") : "Not yet")
                </span>
            </div>
            <div class="cg-keyvalue">
                <span class="cg-keyvalue__key">Bus</span>
                <span class="cg-keyvalue__value">@(Model.BusNumber ?? "Not assigned")</span>
            </div>
            <div class="cg-keyvalue">
                <span class="cg-keyvalue__key">Guardians</span>
                <span class="cg-keyvalue__value">@Model.Guardians.Count</span>
            </div>
            <div class="cg-keyvalue">
                <span class="cg-keyvalue__key">Age</span>
                <span class="cg-keyvalue__value">@age</span>
            </div>
        </div>
    </div>

    <div class="cg-profile__actions">
        <a class="cg-btn cg-btn--secondary" href="/Students/Edit/@Model.StudentId">
            @await Html.PartialAsync("_Icon", "edit") Edit
        </a>
        <a class="cg-btn cg-btn--secondary" href="/Journey/Student/@Model.StudentId">
            @await Html.PartialAsync("_Icon", "journey") Journey
        </a>
        @if (Model.Status == RecordStatus.Active)
        {
            <form asp-action="UpdateStatus" asp-route-id="@Model.StudentId" method="post" class="cg-inline-form"
                  data-cg-confirm="Deactivate @Model.FullName? Their RFID card stops recording checkpoints until the record is reactivated.">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Inactive" />
                <button class="cg-btn cg-btn--danger-soft" type="submit">Deactivate</button>
            </form>
        }
        else
        {
            <form asp-action="UpdateStatus" asp-route-id="@Model.StudentId" method="post" class="cg-inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Active" />
                <button class="cg-btn cg-btn--success" type="submit">Activate</button>
            </form>
        }
    </div>
</section>

<div class="cg-tabs" data-cg-tabs="student" role="tablist">
    <button class="cg-tab is-active" data-cg-tab="overview" role="tab" aria-selected="true">
        @await Html.PartialAsync("_Icon", "dashboard") Overview
    </button>
    <button class="cg-tab" data-cg-tab="attendance" role="tab" aria-selected="false">
        @await Html.PartialAsync("_Icon", "attendance") Attendance
        <span class="cg-tab__count">@Model.RecentAttendance.Count</span>
    </button>
    <button class="cg-tab" data-cg-tab="journey" role="tab" aria-selected="false">
        @await Html.PartialAsync("_Icon", "journey") Journey
        <span class="cg-tab__count">@Model.RecentJourney.Count</span>
    </button>
    <button class="cg-tab" data-cg-tab="guardians" role="tab" aria-selected="false">
        @await Html.PartialAsync("_Icon", "guardians") Guardians
        <span class="cg-tab__count">@Model.Guardians.Count</span>
    </button>
    <button class="cg-tab" data-cg-tab="rfid" role="tab" aria-selected="false">
        @await Html.PartialAsync("_Icon", "rfid") RFID &amp; transport
    </button>
    <button class="cg-tab" data-cg-tab="photo" role="tab" aria-selected="false">
        @await Html.PartialAsync("_Icon", "image") Photo
    </button>
</div>

@* ---------------------------------------------------------------- Overview *@
<div class="cg-tabpanel is-active" data-cg-tabpanel="overview" data-cg-tabs-scope="student" style="padding-top:18px">
    <div class="cg-grid cg-grid--sidebar">
        <div>
            <section class="cg-card">
                <div class="cg-card__head">
                    <div>
                        <h2 class="cg-card__title">Current safety status</h2>
                        <div class="cg-card__sub">From the latest checkpoint recorded today</div>
                    </div>
                </div>
                <div class="cg-card__body">
                    <div class="cg-row" style="gap:16px;align-items:flex-start">
                        <span class="cg-kpi__icon @(Model.SafetyStatus == StudentSafetyStatus.NoActivityToday ? "cg-kpi__icon--neutral" : "cg-kpi__icon--success")"
                              style="width:48px;height:48px;border-radius:12px">
                            @await Html.PartialAsync("_Icon", SafetyUi.Icon(Model.SafetyStatus))
                        </span>
                        <div>
                            <div style="font-size:19px;font-weight:700">@SafetyUi.Label(Model.SafetyStatus)</div>
                            <p class="cg-muted cg-mb-0">@SafetyUi.Explanation(Model.SafetyStatus)</p>
                            @if (Model.LastEventAt is { } lastEventAt)
                            {
                                <p class="cg-text-sm cg-muted" style="margin-top:6px">
                                    Last checkpoint: @SafetyUi.EventLabel(Model.LastEventType) at
                                    @lastEventAt.ToSchoolTime().ToString("HH:mm on d MMM")
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <section class="cg-card">
                <div class="cg-card__head">
                    <div>
                        <h2 class="cg-card__title">Today's activity</h2>
                        <div class="cg-card__sub">Every checkpoint recorded for this student</div>
                    </div>
                </div>
                <div class="cg-card__body">
                    @{
                        var todaysEvents = Model.RecentJourney
                            .Where(e => e.Timestamp.ToSchoolTime().Date == SchoolTime.Today)
                            .OrderBy(e => e.Timestamp)
                            .ToList();
                    }
                    @if (!todaysEvents.Any())
                    {
                        @await Html.PartialAsync("_EmptyState", ("clock", "Nothing recorded today",
                            "This student has not passed a checkpoint today. Earlier days are on the Journey tab.",
                            (string?)null, (string?)null))
                    }
                    else
                    {
                        <ol class="cg-timeline">
                            @foreach (var e in todaysEvents)
                            {
                                <li class="cg-timeline__item">
                                    <span class="cg-timeline__marker cg-timeline__marker--success">
                                        @await Html.PartialAsync("_Icon", SafetyUi.EventIcon(e.EventType))
                                    </span>
                                    <div class="cg-timeline__head">
                                        <span class="cg-timeline__title">@SafetyUi.EventLabel(e.EventType)</span>
                                        <span class="cg-timeline__time">@e.Timestamp.ToSchoolTime().ToString("HH:mm")</span>
                                    </div>
                                    <div class="cg-timeline__body">
                                        @(e.Source == EventSource.Rfid ? "RFID verification" : "Recorded by staff")
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </section>
        </div>

        <div>
            <section class="cg-card">
                <div class="cg-card__head">
                    <h2 class="cg-card__title">Attendance</h2>
                    <span class="cg-badge cg-badge--neutral">Last @stats.WindowDays days</span>
                </div>
                <div class="cg-card__body">
                    <div class="cg-kpi__value" style="font-size:34px">
                        @stats.PresentRate.ToString("0.#", CultureInfo.InvariantCulture)<span class="cg-kpi__unit">%</span>
                    </div>
                    <p class="cg-text-sm cg-muted">
                        Present on @stats.DaysPresent of @stats.SchoolDaysObserved recorded school days.
                    </p>
                    <div class="cg-meter" style="margin:10px 0 14px">
                        <div class="cg-meter__fill" style="width:@stats.PresentRate.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <div class="cg-grid cg-grid--2" style="margin-bottom:0;gap:12px">
                        <div class="cg-keyvalue">
                            <span class="cg-keyvalue__key">Days present</span>
                            <span class="cg-keyvalue__value">@stats.DaysPresent</span>
                        </div>
                        <div class="cg-keyvalue">
                            <span class="cg-keyvalue__key">Late arrivals</span>
                            <span class="cg-keyvalue__value">@stats.DaysLate</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="cg-card">
                <div class="cg-card__head">
                    <h2 class="cg-card__title">Record details</h2>
                </div>
                <div class="cg-card__body">
                    <dl class="cg-deflist">
                        <dt>Date of birth</dt>
                        <dd>@Model.DateOfBirth.ToString("d MMMM yyyy")</dd>
                        <dt>Grade</dt>
                        <dd>@(Model.Grade ?? "—")</dd>
                        <dt>Bus</dt>
                        <dd>@(Model.BusNumber ?? "Not assigned")</dd>
                        <dt>Route</dt>
                        <dd>@(Model.RouteName ?? "—")</dd>
                        <dt>Driver</dt>
                        <dd>@(Model.DriverName ?? "—")</dd>
                        <dt>Added</dt>
                        <dd>@Model.CreatedAt.ToSchoolTime().ToString("d MMM yyyy")</dd>
                    </dl>
                </div>
            </section>
        </div>
    </div>
</div>

@* -------------------------------------------------------------- Attendance *@
<div class="cg-tabpanel" data-cg-tabpanel="attendance" data-cg-tabs-scope="student" style="padding-top:18px">
    <section class="cg-card">
        <div class="cg-card__head">
            <div>
                <h2 class="cg-card__title">Recent attendance</h2>
                <div class="cg-card__sub">Most recent arrivals and departures</div>
            </div>
            <a class="cg-btn cg-btn--sm cg-btn--secondary" href="/Attendance?studentId=@Model.StudentId">
                Full attendance history
            </a>
        </div>
        @if (!Model.RecentAttendance.Any())
        {
            @await Html.PartialAsync("_EmptyState", ("attendance", "No attendance recorded",
                "Attendance is created automatically when this student scans in or out at school.",
                (string?)null, (string?)null))
        }
        else
        {
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr><th>Event</th><th>Date</th><th>Time</th><th>Punctuality</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model.RecentAttendance)
                    {
                        <tr>
                            <td>
                                <span class="cg-badge @(a.EventType == AttendanceEventType.SchoolArrival ? "cg-badge--success" : "cg-badge--neutral")">
                                    @await Html.PartialAsync("_Icon", a.EventType == AttendanceEventType.SchoolArrival ? "log-in" : "log-out")
                                    @(a.EventType == AttendanceEventType.SchoolArrival ? "Arrival" : "Departure")
                                </span>
                            </td>
                            <td>@a.Date.ToString("ddd d MMM yyyy")</td>
                            <td class="cg-num">@a.Time.ToString("HH:mm")</td>
                            <td>
                                @if (a.EventType != AttendanceEventType.SchoolArrival)
                                {
                                    <span class="cg-muted">—</span>
                                }
                                else if (a.IsLate)
                                {
                                    <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>Late</span>
                                }
                                else
                                {
                                    <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>On time</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@* ----------------------------------------------------------------- Journey *@
<div class="cg-tabpanel" data-cg-tabpanel="journey" data-cg-tabs-scope="student" style="padding-top:18px">
    <section class="cg-card">
        <div class="cg-card__head">
            <div>
                <h2 class="cg-card__title">Journey timeline</h2>
                <div class="cg-card__sub">
                    Checkpoint events only — ChildGuard records where a student was seen, not continuous location.
                </div>
            </div>
            <a class="cg-btn cg-btn--sm cg-btn--secondary" href="/Journey/Student/@Model.StudentId">Full timeline</a>
        </div>
        <div class="cg-card__body">
            @if (!Model.RecentJourney.Any())
            {
                @await Html.PartialAsync("_EmptyState", ("journey", "No journey events yet",
                    "Events appear as the student's card is read at bus boarding, school arrival, departure and drop-off.",
                    (string?)null, (string?)null))
            }
            else
            {
                <ol class="cg-timeline">
                    @foreach (var e in Model.RecentJourney)
                    {
                        <li class="cg-timeline__item">
                            <span class="cg-timeline__marker">
                                @await Html.PartialAsync("_Icon", SafetyUi.EventIcon(e.EventType))
                            </span>
                            <div class="cg-timeline__head">
                                <span class="cg-timeline__title">@SafetyUi.EventLabel(e.EventType)</span>
                                <span class="cg-timeline__time">@e.Timestamp.ToSchoolTime().ToString("ddd d MMM, HH:mm")</span>
                            </div>
                            <div class="cg-timeline__body">
                                @(e.Source == EventSource.Rfid ? "RFID verification" : "Recorded by staff")
                            </div>
                        </li>
                    }
                </ol>
            }
        </div>
    </section>
</div>

@* --------------------------------------------------------------- Guardians *@
<div class="cg-tabpanel" data-cg-tabpanel="guardians" data-cg-tabs-scope="student" style="padding-top:18px">
    <section class="cg-card">
        <div class="cg-card__head">
            <div>
                <h2 class="cg-card__title">Linked guardians</h2>
                <div class="cg-card__sub">@authorisedCount of @Model.Guardians.Count authorised to collect this student</div>
            </div>
            <button type="button" class="cg-btn cg-btn--primary cg-btn--sm" data-cg-modal-open="linkGuardianModal">
                @await Html.PartialAsync("_Icon", "plus") Link guardian
            </button>
        </div>

        @if (!Model.Guardians.Any())
        {
            @await Html.PartialAsync("_EmptyState", ("guardians", "No guardians linked",
                "Nobody can be verified to collect this student until a guardian is linked and authorised for pickup.",
                (string?)null, (string?)null))
        }
        else
        {
            <div class="cg-card__body">
                <div class="cg-grid cg-grid--2" style="margin-bottom:0">
                    @foreach (var g in Model.Guardians)
                    {
                        var guardianPhoto = g.HasPhoto ? Url.Action("Photo", "Guardians", new { id = g.GuardianId }) : null;
                        <div class="cg-personcard" style="flex-direction:column;gap:14px">
                            <div class="cg-row" style="align-items:flex-start">
                                @await Html.PartialAsync("_Avatar", new AvatarModel(guardianPhoto, g.FullName, "md", true))
                                <div class="cg-personcard__body">
                                    <a class="cg-personcard__name" href="/Guardians/Details/@g.GuardianId">@g.FullName</a>
                                    <div class="cg-personcard__meta">@(g.Relationship ?? "Relationship not set")</div>
                                    <div class="cg-personcard__facts">
                                        <span class="cg-personcard__fact">
                                            @await Html.PartialAsync("_Icon", "mail") @g.Email
                                        </span>
                                        @if (!string.IsNullOrEmpty(g.Phone))
                                        {
                                            <span class="cg-personcard__fact">
                                                @await Html.PartialAsync("_Icon", "phone") @g.Phone
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="cg-row cg-row--wrap">
                                @if (g.IsAuthorizedForPickup)
                                {
                                    <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>Authorised for pickup</span>
                                }
                                else
                                {
                                    <span class="cg-badge cg-badge--neutral"><span class="cg-badge__dot"></span>Not authorised</span>
                                }
                                @if (g.FaceRegistered)
                                {
                                    <span class="cg-badge cg-badge--primary">@await Html.PartialAsync("_Icon", "camera") Face registered</span>
                                }
                                else
                                {
                                    <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>No face registered</span>
                                }
                            </div>

                            <form asp-action="UpdateGuardianLink" asp-route-id="@Model.StudentId" method="post"
                                  class="cg-row cg-row--wrap" style="gap:8px">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="guardianId" value="@g.GuardianId" />
                                <input class="cg-input" name="relationship" value="@g.Relationship"
                                       placeholder="Relationship" maxlength="50" style="max-width:150px"
                                       aria-label="Relationship to @g.FullName" />
                                <label class="cg-check">
                                    <input type="checkbox" name="isAuthorizedForPickup" value="true" checked="@g.IsAuthorizedForPickup" />
                                    <span class="cg-check__text cg-text-sm">Pickup</span>
                                </label>
                                <button class="cg-btn cg-btn--secondary cg-btn--sm" type="submit">Save</button>
                            </form>

                            <form asp-action="RemoveGuardianLink" asp-route-id="@Model.StudentId" method="post"
                                  data-cg-confirm="Unlink @g.FullName from @Model.FullName? The guardian account itself is not deleted.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="guardianId" value="@g.GuardianId" />
                                <button class="cg-btn cg-btn--ghost cg-btn--sm" type="submit"
                                        style="color:var(--cg-danger)">
                                    @await Html.PartialAsync("_Icon", "trash") Unlink
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </section>
</div>

@* ------------------------------------------------------- RFID and transport *@
<div class="cg-tabpanel" data-cg-tabpanel="rfid" data-cg-tabs-scope="student" style="padding-top:18px">
    <div class="cg-grid cg-grid--2">
        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">RFID card</h2>
                @if (Model.RfidStatus is { } rfidStatus)
                {
                    var badge = rfidStatus switch
                    {
                        RfidCardStatus.Active => "cg-badge--success",
                        RfidCardStatus.Lost => "cg-badge--danger",
                        _ => "cg-badge--neutral"
                    };
                    <span class="cg-badge @badge"><span class="cg-badge__dot"></span>@rfidStatus</span>
                }
            </div>
            <div class="cg-card__body">
                @if (Model.MaskedRfid is null)
                {
                    @await Html.PartialAsync("_EmptyState", ("rfid", "No card assigned",
                        "This student cannot be identified at a checkpoint until an RFID card is assigned.",
                        "Assign a card", "/Rfid"))
                }
                else
                {
                    <dl class="cg-deflist">
                        <dt>Card UID</dt>
                        <dd class="cg-mono">@Model.MaskedRfid</dd>
                        <dt>Assigned</dt>
                        <dd>@(Model.RfidAssignedAt?.ToSchoolTime().ToString("d MMM yyyy") ?? "—")</dd>
                    </dl>
                    <p class="cg-hint">
                        Only the last four characters of a card UID are ever shown, so a full
                        credential cannot be copied from this screen.
                    </p>
                    <a class="cg-btn cg-btn--secondary cg-btn--sm" href="/Rfid">Manage RFID cards</a>
                }
            </div>
        </section>

        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">Transport</h2>
            </div>
            <div class="cg-card__body">
                @if (Model.BusNumber is null)
                {
                    @await Html.PartialAsync("_EmptyState", ("bus", "No bus assigned",
                        "Assign this student to a bus so their boarding and drop-off checkpoints are attributed to a route.",
                        "Open transportation", "/Transportation"))
                }
                else
                {
                    <dl class="cg-deflist">
                        <dt>Bus</dt>
                        <dd>@Model.BusNumber</dd>
                        <dt>Route</dt>
                        <dd>@(Model.RouteName ?? "—")</dd>
                        <dt>Driver</dt>
                        <dd>@(Model.DriverName ?? "—")</dd>
                    </dl>
                    <a class="cg-btn cg-btn--secondary cg-btn--sm" href="/Transportation">Manage transport</a>
                }
            </div>
        </section>
    </div>
</div>

@* ------------------------------------------------------------------- Photo *@
<div class="cg-tabpanel" data-cg-tabpanel="photo" data-cg-tabs-scope="student" style="padding-top:18px">
    @await Html.PartialAsync("_PhotoManager", new PhotoManagerModel(
        "Students", Model.StudentId, Model.FullName, Model.HasPhoto, Model.PhotoUpdatedAt, false,
        "Student photo",
        "Helps staff match a child to their record at the pickup desk."))
</div>

@* ------------------------------------------------------------ Link modal *@
<div class="cg-modal" id="linkGuardianModal" hidden role="dialog" aria-modal="true" aria-labelledby="linkGuardianTitle">
    <div class="cg-modal__panel">
        <div class="cg-modal__head">
            <div>
                <h2 class="cg-modal__title" id="linkGuardianTitle">Link a guardian</h2>
                <div class="cg-modal__sub">Authorised guardians can be verified to collect @Model.FullName.</div>
            </div>
            <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">
                @await Html.PartialAsync("_Icon", "x")
            </button>
        </div>

        @if (!availableGuardians.Any())
        {
            <div class="cg-modal__body">
                <p class="cg-muted">
                    Every registered guardian is already linked to this student.
                    <a href="/Guardians/Create">Add a new guardian</a> first.
                </p>
            </div>
            <div class="cg-modal__foot">
                <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Close</button>
            </div>
        }
        else
        {
            <form asp-action="AssignGuardian" asp-route-id="@Model.StudentId" method="post" data-cg-busy>
                @Html.AntiForgeryToken()
                <div class="cg-modal__body">
                    <div class="cg-form">
                        <div class="cg-field">
                            <label class="cg-label" for="linkGuardianId">Guardian</label>
                            <select class="cg-select" id="linkGuardianId" name="guardianId" required>
                                @foreach (var g in availableGuardians)
                                {
                                    <option value="@g.GuardianId">@g.FullName — @g.Email</option>
                                }
                            </select>
                        </div>
                        <div class="cg-field">
                            <label class="cg-label" for="linkRelationship">Relationship</label>
                            <input class="cg-input" id="linkRelationship" name="relationship"
                                   placeholder="Mother, Father, Grandparent…" maxlength="50" />
                        </div>
                        <label class="cg-check">
                            <input type="checkbox" name="isAuthorizedForPickup" value="true" />
                            <span class="cg-check__text">
                                Authorise for pickup
                                <span class="cg-check__sub">
                                    Required before this guardian can be face-verified to collect the student.
                                </span>
                            </span>
                        </label>
                    </div>
                </div>
                <div class="cg-modal__foot">
                    <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                    <button type="submit" class="cg-btn cg-btn--primary">
                        <span class="cg-btn__label">Link guardian</span>
                    </button>
                </div>
            </form>
        }
    </div>
</div>
