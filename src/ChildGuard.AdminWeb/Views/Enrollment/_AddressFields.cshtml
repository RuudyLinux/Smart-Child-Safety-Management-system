@model string
@* Address inputs, read by enrollment.js through data-a. @Model only namespaces error targets. *@
<div class="cg-form">
    <div class="cg-form-row">
        <div class="cg-field">
            <label class="cg-label">Address line 1</label>
            <input class="cg-input" data-a="line1" maxlength="200" placeholder="House / flat number, building, street" />
        </div>
        <div class="cg-field">
            <label class="cg-label">Address line 2 <span class="cg-muted">(optional)</span></label>
            <input class="cg-input" data-a="line2" maxlength="200" />
        </div>
    </div>
    <div class="cg-form-row">
        <div class="cg-field">
            <label class="cg-label">Area / locality</label>
            <input class="cg-input" data-a="locality" maxlength="100" />
        </div>
        <div class="cg-field">
            <label class="cg-label">Landmark <span class="cg-muted">(optional)</span></label>
            <input class="cg-input" data-a="landmark" maxlength="100" />
        </div>
    </div>
    <div class="cg-form-row">
        <div class="cg-field">
            <label class="cg-label">City</label>
            <input class="cg-input" data-a="city" maxlength="100" />
        </div>
        <div class="cg-field">
            <label class="cg-label">District</label>
            <input class="cg-input" data-a="district" maxlength="100" />
        </div>
        <div class="cg-field">
            <label class="cg-label">State</label>
            <input class="cg-input" data-a="state" maxlength="100" />
        </div>
    </div>
    <div class="cg-form-row">
        <div class="cg-field">
            <label class="cg-label">PIN / postal code</label>
            <input class="cg-input cg-mono" data-a="postalCode" maxlength="20" inputmode="numeric" />
            <span class="cg-error-text" data-a-error="postalCode"></span>
        </div>
        <div class="cg-field">
            <label class="cg-label">Country</label>
            <input class="cg-input" data-a="country" maxlength="100" value="India" />
        </div>
    </div>
</div>
