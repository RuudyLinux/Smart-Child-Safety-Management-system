@{
    ViewData["Title"] = "Temporary Pickup Desk";
}

<div class="cg-page-head">
    <div class="cg-page-head__text">
        <h1 class="cg-page-head__title">Temporary pickup desk</h1>
        <p class="cg-page-head__sub">
            Scan the QR code on the collecting person's phone, check who they should be, then capture their face. The child is released only when the QR is valid, the child is checked in at school and the face matches the photo the guardian supplied.
        </p>
    </div>
    <div class="cg-page-head__actions">
        <a class="cg-btn cg-btn--secondary" href="/TemporaryPickups">All temporary pickups</a>
    </div>
</div>

<div id="deskAlert" class="cg-alert cg-alert--danger" role="alert" hidden>
    <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
    <div class="cg-alert__body" id="deskAlertText"></div>
</div>

<div class="cg-grid cg-grid--2">
    <section class="cg-card" id="stepScan">
        <div class="cg-card__head"><div>
            <h2 class="cg-card__title">1 · Scan the QR code</h2>
            <div class="cg-card__sub">Use the camera, or paste the code if scanning is not available</div>
        </div></div>
        <div class="cg-card__body">
            <video id="qrVideo" playsinline muted style="width:100%;border-radius:14px;background:#0b1220;display:none;max-height:280px;object-fit:cover"></video>
            <div class="cg-row cg-row--wrap" style="margin-top:12px">
                <button type="button" class="cg-btn cg-btn--secondary" id="qrCameraBtn">Start camera scan</button>
                <span class="cg-muted cg-text-sm" id="qrSupport"></span>
            </div>
            <div class="cg-field" style="margin-top:14px">
                <label class="cg-label" for="qrToken">QR code text</label>
                <input class="cg-input cg-mono" id="qrToken" autocomplete="off" placeholder="CGTP1.…" />
                <p class="cg-hint">A handheld scanner in keyboard mode types the code here. Press Enter to check it.</p>
            </div>
            <button type="button" class="cg-btn cg-btn--primary" id="checkTokenBtn"><span class="cg-btn__label">Check code</span></button>
        </div>
    </section>

    <section class="cg-card" id="stepPerson" hidden>
        <div class="cg-card__head"><div>
            <h2 class="cg-card__title">2 · Who should be here</h2>
            <div class="cg-card__sub">Compare with the person at the desk</div>
        </div></div>
        <div class="cg-card__body">
            <div class="cg-row" style="gap:16px;align-items:flex-start">
                <img id="personPhoto" alt="Photo supplied by the guardian" style="width:120px;height:120px;object-fit:cover;border-radius:16px;border:1px solid var(--cg-border)" />
                <dl class="cg-deflist" style="flex:1">
                    <dt>Person</dt><dd id="pName"></dd>
                    <dt>Relationship</dt><dd id="pRel"></dd>
                    <dt>Contact</dt><dd id="pPhone"></dd>
                    <dt>ID hint</dt><dd id="pId"></dd>
                    <dt>Child</dt><dd id="pStudent"></dd>
                    <dt>Arranged by</dt><dd id="pBy"></dd>
                    <dt>Valid until</dt><dd id="pUntil"></dd>
                </dl>
            </div>
            <div id="blocked" class="cg-alert cg-alert--danger" style="margin-top:14px" hidden>
                <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
                <div class="cg-alert__body"><div class="cg-alert__title">Do not release the child</div><span id="blockedText"></span></div>
            </div>
        </div>
    </section>
</div>

<section class="cg-card" id="stepFace" hidden>
    <div class="cg-card__head"><div>
        <h2 class="cg-card__title">3 · Face check</h2>
        <div class="cg-card__sub">Capture the person's face; it is compared with the guardian's photo</div>
    </div></div>
    <div class="cg-card__body">
        <div class="cg-row cg-row--wrap" style="gap:16px;align-items:flex-start">
            <div>
                <video id="faceVideo" playsinline muted style="width:320px;max-width:100%;border-radius:14px;background:#0b1220"></video>
                <canvas id="faceCanvas" hidden></canvas>
            </div>
            <div style="flex:1;min-width:220px">
                <button type="button" class="cg-btn cg-btn--secondary" id="faceCameraBtn">Start camera</button>
                <button type="button" class="cg-btn cg-btn--success" id="handoverBtn" disabled><span class="cg-btn__label">Verify face and hand over</span></button>
                <div id="handoverResult" class="cg-alert" style="margin-top:14px" hidden></div>
                <p class="cg-hint" style="margin-top:12px">If the face does not match, the child stays at school, the guardian is notified and the attempt is logged.</p>
            </div>
        </div>
    </div>
</section>

<script src="~/js/temporary-pickup-desk.js" asp-append-version="true"></script>
