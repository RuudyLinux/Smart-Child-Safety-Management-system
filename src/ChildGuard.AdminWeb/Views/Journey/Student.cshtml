@model List<JourneyEventDto>
@{
    var student = ViewBag.Student as StudentDetailDto;
    var name = student?.FullName ?? Model.FirstOrDefault()?.StudentName ?? "Student";
    ViewData["Title"] = $"{name} — journey";
    var photoUrl = student is { HasPhoto: true }
        ? Url.Action("Photo", "Students", new { id = student.StudentId })
        : null;
    var byDay = Model
        .OrderByDescending(e => e.Timestamp)
        .GroupBy(e => e.Timestamp.ToLocalTime().Date)
        .ToList();
}

<div class="cg-page-head">
    <div class="cg-page-head__text">
        <nav class="cg-breadcrumb" style="margin-bottom:6px">
            <a href="/Journey">@await Html.PartialAsync("_Icon", "arrow-left") Back to journey board</a>
        </nav>
        <h1 class="cg-page-head__title">Journey timeline</h1>
        <p class="cg-page-head__sub">Every recorded checkpoint for @name, newest day first.</p>
    </div>
    @if (student is not null)
    {
        <div class="cg-page-head__actions">
            <a class="cg-btn cg-btn--secondary" href="/Students/Details/@student.StudentId">
                @await Html.PartialAsync("_Icon", "students") Student profile
            </a>
        </div>
    }
</div>

@if (student is not null)
{
    <section class="cg-profile">
        @await Html.PartialAsync("_Avatar", new AvatarModel(photoUrl, name, "lg", false, true,
            SafetyUi.DotColor(student.SafetyStatus), SafetyUi.Label(student.SafetyStatus)))
        <div class="cg-profile__main">
            <h2 class="cg-profile__name" style="font-size:19px">@name</h2>
            <div class="cg-profile__meta">
                @await Html.PartialAsync("_SafetyChip", student.SafetyStatus)
                <span class="cg-tag">@(student.Grade ?? "No grade")</span>
                @if (student.BusNumber is not null)
                {
                    <span class="cg-tag">@await Html.PartialAsync("_Icon", "bus") @student.BusNumber</span>
                }
            </div>
        </div>
    </section>
}

<section class="cg-card">
    <div class="cg-card__head">
        <div>
            <h2 class="cg-card__title">Checkpoint history</h2>
            <div class="cg-card__sub">@Model.Count event@(Model.Count == 1 ? "" : "s") recorded</div>
        </div>
    </div>

    <div class="cg-card__body">
        @if (!Model.Any())
        {
            @await Html.PartialAsync("_EmptyState", ("journey", "No journey events recorded",
                "Events appear as this student's card is read at bus boarding, school arrival, departure and drop-off.",
                (string?)null, (string?)null))
        }
        else
        {
            foreach (var day in byDay)
            {
                var isToday = day.Key == DateTime.Today;
                <div class="cg-section-head" style="margin-top:18px">
                    <span class="cg-section-head__title">
                        @(isToday ? "Today" : day.Key.ToString("dddd, d MMMM yyyy"))
                    </span>
                    <span class="cg-text-sm cg-muted">@day.Count() checkpoint@(day.Count() == 1 ? "" : "s")</span>
                </div>

                <ol class="cg-timeline">
                    @foreach (var e in day.OrderBy(x => x.Timestamp))
                    {
                        var marker = e.EventType switch
                        {
                            JourneyEventType.SchoolArrival or JourneyEventType.BusDropoff => "cg-timeline__marker--success",
                            JourneyEventType.SchoolDeparture => "cg-timeline__marker--warning",
                            _ => ""
                        };
                        <li class="cg-timeline__item">
                            <span class="cg-timeline__marker @marker">
                                @await Html.PartialAsync("_Icon", SafetyUi.EventIcon(e.EventType))
                            </span>
                            <div class="cg-timeline__head">
                                <span class="cg-timeline__title">@SafetyUi.EventLabel(e.EventType)</span>
                                <span class="cg-timeline__time">@e.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            <div class="cg-timeline__body">
                                @(e.Source == EventSource.Rfid
                                    ? "Identified by RFID card at the checkpoint reader."
                                    : "Recorded by staff at the pickup desk.")
                            </div>
                        </li>
                    }
                </ol>
            }
        }
    </div>
</section>
