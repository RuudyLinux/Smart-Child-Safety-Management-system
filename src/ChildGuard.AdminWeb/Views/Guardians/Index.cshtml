@model List<GuardianListItemDto>
@{
    ViewData["Title"] = "Guardians";
    var withPhoto = Model.Count(g => g.HasPhoto);
    var faceReady = Model.Count(g => g.FaceRegistered);
    var pendingReset = Model.Count(g => g.PasswordResetRequired);
    var unlinked = Model.Count(g => g.LinkedStudentCount == 0);
}

<div class="cg-page-head">
    <div class="cg-page-head__text">
        <h1 class="cg-page-head__title">Guardians</h1>
        <p class="cg-page-head__sub">
            @Model.Count registered · @faceReady ready for face verification · @withPhoto with a photo on file
        </p>
    </div>
    <div class="cg-page-head__actions">
        <a class="cg-btn cg-btn--primary" href="/Guardians/Create">@await Html.PartialAsync("_Icon", "plus") Add guardian</a>
    </div>
</div>

@if (ViewBag.LoadError is string loadError)
{
    <div class="cg-alert cg-alert--danger" role="alert">
        <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
        <div class="cg-alert__body">@loadError</div>
    </div>
}

<div class="cg-grid cg-grid--4">
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Registered guardians</div>
            <span class="cg-kpi__icon cg-kpi__icon--info">@await Html.PartialAsync("_Icon", "guardians")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Model.Count</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Face registered</div>
            <span class="cg-kpi__icon cg-kpi__icon--success">@await Html.PartialAsync("_Icon", "camera")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@faceReady</div>
        <div class="cg-kpi__note">Can be verified at the pickup desk</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Awaiting first sign-in</div>
            <span class="cg-kpi__icon @(pendingReset > 0 ? "cg-kpi__icon--warning" : "cg-kpi__icon--neutral")">
                @await Html.PartialAsync("_Icon", "key")
            </span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@pendingReset</div>
        <div class="cg-kpi__note">Still on an issued password</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">No linked children</div>
            <span class="cg-kpi__icon @(unlinked > 0 ? "cg-kpi__icon--warning" : "cg-kpi__icon--neutral")">
                @await Html.PartialAsync("_Icon", "user-x")
            </span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@unlinked</div>
        <div class="cg-kpi__note">Cannot collect anyone yet</div>
    </article>
</div>

<section class="cg-card">
    <div class="cg-toolbar">
        <div class="cg-input-group cg-toolbar__grow" style="max-width:320px">
            <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "search")</span>
            <input class="cg-input" placeholder="Search name, email or number"
                   data-cg-search data-cg-search-scope="guardians" aria-label="Search guardians" />
        </div>

        <select class="cg-select" style="max-width:170px" data-cg-filter="verification" data-cg-filter-scope="guardians"
                aria-label="Filter by face registration">
            <option value="__all">Any verification</option>
            <option value="ready">Face registered</option>
            <option value="missing">No face registered</option>
        </select>

        <select class="cg-select" style="max-width:160px" data-cg-filter="children" data-cg-filter-scope="guardians"
                aria-label="Filter by linked children">
            <option value="__all">Any children</option>
            <option value="linked">Has children</option>
            <option value="none">No children</option>
        </select>

        <select class="cg-select" style="max-width:150px" data-cg-filter="status" data-cg-filter-scope="guardians"
                aria-label="Filter by account status">
            <option value="__all">Any status</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
                <option value="Archived">Archived</option>
        </select>

        <button type="button" class="cg-btn cg-btn--ghost cg-btn--sm" data-cg-reset data-cg-reset-scope="guardians">Clear</button>
        <span class="cg-toolbar__spacer"></span>
        <span class="cg-text-sm cg-muted" data-cg-count data-cg-count-scope="guardians"></span>
    </div>

    @if (!Model.Any())
    {
        @await Html.PartialAsync("_EmptyState", ("guardians", "No guardians yet",
            "Add a guardian and ChildGuard emails them their sign-in details automatically.",
            "Add guardian", "/Guardians/Create"))
    }
    else
    {
        <div class="cg-table-wrap">
            <table class="cg-table" data-cg-table="guardians" data-cg-page-size="25">
                <thead>
                    <tr>
                        <th><span class="cg-th-sort" data-cg-sort="name">Guardian @await Html.PartialAsync("_Icon", "arrow-down")</span></th>
                        <th>Contact</th>
                        <th><span class="cg-th-sort" data-cg-sort="children">Children @await Html.PartialAsync("_Icon", "arrow-down")</span></th>
                        <th>Verification</th>
                        <th>Account</th>
                        <th><span class="cg-th-sort" data-cg-sort="activity">Last activity @await Html.PartialAsync("_Icon", "arrow-down")</span></th>
                        <th class="cg-table__actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var g in Model)
                {
                    var photoUrl = g.HasPhoto
                        ? Url.Action("Photo", "Guardians", new { id = g.GuardianId, v = g.PhotoUpdatedAt?.Ticks })
                        : null;
                    <tr data-row
                        data-search="@g.FullName @g.Email @g.Phone"
                        data-verification="@(g.FaceRegistered ? "ready" : "missing")"
                        data-children="@(g.LinkedStudentCount == 0 ? "none" : "linked")"
                        data-status="@(g.ArchivedAt is not null ? "Archived" : g.Status.ToString())"
                        data-sort-name="@g.FullName"
                        data-sort-children="@g.LinkedStudentCount"
                        data-sort-activity="@(g.LastActivityAt?.Ticks ?? 0)">
                        <td>
                            <a class="cg-identity" href="/Guardians/Details/@g.GuardianId" style="color:inherit">
                                @await Html.PartialAsync("_Avatar", new AvatarModel(photoUrl, g.FullName, "sm", true))
                                <span class="cg-identity__body">
                                    <span class="cg-identity__name">@g.FullName</span>
                                    <span class="cg-identity__meta">@g.Email</span>
                                </span>
                            </a>
                        </td>
                        <td class="cg-text-sm">
                            @if (!string.IsNullOrEmpty(g.Phone))
                            {
                                <span class="cg-mono">@g.Phone</span>
                                <div class="cg-muted">Sign-in ID</div>
                            }
                            else
                            {
                                <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>No number</span>
                            }
                        </td>
                        <td>
                            @if (g.LinkedStudentCount == 0)
                            {
                                <span class="cg-badge cg-badge--neutral">None</span>
                            }
                            else
                            {
                                <span class="cg-badge cg-badge--primary">@g.LinkedStudentCount linked</span>
                            }
                        </td>
                        <td>
                            @if (g.FaceRegistered)
                            {
                                <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>Face registered</span>
                            }
                            else
                            {
                                <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>Not registered</span>
                            }
                        </td>
                        <td>
                            @if (g.ArchivedAt is not null)
                            {
                                <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>Archived</span>
                            }
                            else if (g.Status != RecordStatus.Active)
                            {
                                <span class="cg-badge cg-badge--neutral"><span class="cg-badge__dot"></span>Inactive</span>
                            }
                            else if (g.PasswordResetRequired)
                            {
                                <span class="cg-badge cg-badge--warning"><span class="cg-badge__dot"></span>First sign-in pending</span>
                            }
                            else
                            {
                                <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>Active</span>
                            }
                        </td>
                        <td class="cg-text-sm cg-muted">
                            @if (g.LastActivityAt is { } lastAt)
                            {
                                <span data-cg-ago="@lastAt.ToString("O")">@lastAt.ToSchoolTime().ToString("d MMM")</span>
                            }
                            else
                            {
                                <span>No verifications yet</span>
                            }
                        </td>
                        <td class="cg-table__actions">
                            <span class="cg-table__row-actions">
                                <a class="cg-btn cg-btn--sm cg-btn--ghost cg-btn--icon" href="/Guardians/Details/@g.GuardianId"
                                   title="View profile" aria-label="View @g.FullName">
                                    @await Html.PartialAsync("_Icon", "eye")
                                </a>
                                <a class="cg-btn cg-btn--sm cg-btn--ghost cg-btn--icon" href="/Guardians/Edit/@g.GuardianId"
                                   title="Edit" aria-label="Edit @g.FullName">
                                    @await Html.PartialAsync("_Icon", "edit")
                                </a>
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="cg-empty" data-cg-noresults data-cg-noresults-scope="guardians" hidden>
            <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
            <div class="cg-empty__title">No guardians match these filters</div>
            <p class="cg-empty__text">Clear one or more filters to widen the list.</p>
        </div>

        <div class="cg-pagination">
            <span class="cg-text-sm">Showing up to 25 guardians per page</span>
            <div class="cg-pagination__pages" data-cg-pager data-cg-pager-scope="guardians"></div>
        </div>
    }
</section>
