@model AdminUpdateGuardianRequest
@{
    ViewData["Title"] = "Edit Guardian";
    var guardianId = (int)ViewData["GuardianId"]!;
}

<div class="cg-card">
    <h3 class="cg-card__title cg-mt-0">Edit Guardian</h3>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="cg-alert cg-alert--error">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Edit" asp-route-id="@guardianId" method="post" class="cg-form">
        @Html.AntiForgeryToken()
        <div class="cg-form-group">
            <label for="FullName">Full Name</label>
            <input type="text" id="FullName" name="FullName" value="@Model.FullName" required maxlength="150" class="cg-input" />
        </div>
        <div class="cg-form-group">
            <label for="Email">Email</label>
            <input type="email" id="Email" name="Email" value="@Model.Email" required maxlength="200" class="cg-input" />
        </div>
        <div class="cg-form-group">
            <label for="ContactNumber">Contact Number</label>
            <input type="tel" id="ContactNumber" name="ContactNumber" value="@Model.ContactNumber" required maxlength="30" class="cg-input" />
            <small class="cg-muted">The guardian signs in with this number, so it must be unique.</small>
        </div>
        <div class="cg-form-group">
            <label for="Status">Status</label>
            <select id="Status" name="Status" class="cg-select">
                <option value="@RecordStatus.Active" selected="@(Model.Status == RecordStatus.Active)">Active</option>
                <option value="@RecordStatus.Inactive" selected="@(Model.Status == RecordStatus.Inactive)">Inactive</option>
            </select>
        </div>
        <button class="cg-btn cg-btn--primary" type="submit">Save Changes</button>
        <a class="cg-btn" href="/Guardians/Details/@guardianId">Cancel</a>
    </form>
</div>
