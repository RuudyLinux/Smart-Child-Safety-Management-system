@model List<BusDto>
@{
    ViewData["Title"] = "Transportation";
    var routes = (List<RouteDto>)ViewBag.Routes;
    var drivers = (List<DriverDto>)ViewBag.Drivers;
    var assignments = (ListPageViewModel<StudentBusAssignmentDto>)ViewBag.Assignments;
    var q = (ListQuery)ViewData["Query"]!;
    // Shared partials (delete modal, photo) render their forms as AJAX forms on this page.
    ViewData["AjaxForms"] = true;
    var students = (List<StudentListItemDto>)ViewBag.Students;

    var activeBuses = Model.Count(b => b.Status == BusStatus.Active);
    var withoutDriver = Model.Count(b => string.IsNullOrEmpty(b.DriverName));
    var activeAssignments = assignments.Items.Where(a => a.Status == RecordStatus.Active).ToList();   // this page of the list: its change-bus modals
    // A student's current bus comes with the student list, so "on a bus" does not need every assignment.
    var assignedStudentCount = students.Count(s => s.BusNumber is not null);
    var inServiceBuses = Model.Where(b => b.Status == BusStatus.Active).ToList();
    // Pickers offer active drivers and routes, plus whatever a bus already has.
    bool Offer(RecordStatus status, bool current) => status == RecordStatus.Active || current;
    var unassignedStudents = students.Where(s => s.BusNumber is null).ToList();
    var settings = ViewBag.Settings as TransportSettingsDto ?? new TransportSettingsDto(false);
    var audit = ViewBag.Audit as List<TransportAuditDto> ?? new();
    var driverNames = drivers.ToDictionary(d => d.DriverId, d => d.FullName);
    var routeNames = routes.ToDictionary(r => r.RouteId, r => r.RouteName);
    // Occupancy comes from the API's live count of active assignments, recalculated on every load.
    bool IsFull(BusDto b) => b.ActiveStudentCount >= b.Capacity;
    string Seats(BusDto b) => $"{b.ActiveStudentCount}/{b.Capacity} seats";
    string BusOption(BusDto b) => $"{b.BusNumber}{(string.IsNullOrEmpty(b.RouteName) ? "" : $" — {b.RouteName}")} ({Seats(b)}{(IsFull(b) ? ", full" : "")})";
    var hasFreeSeat = inServiceBuses.Any(b => !IsFull(b));
}

<div data-cg-region="fleet-console">
<div class="cg-page-head">
    <div class="cg-page-head__text">
        <h1 class="cg-page-head__title">Transportation</h1>
        <p class="cg-page-head__sub">
            @activeBuses bus@(activeBuses == 1 ? "" : "es") in service · @drivers.Count driver@(drivers.Count == 1 ? "" : "s") ·
            @routes.Count route@(routes.Count == 1 ? "" : "s")
        </p>
    </div>
    <div class="cg-page-head__actions">
        <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-open="addDriverModal">
            @await Html.PartialAsync("_Icon", "steering") Add driver
        </button>
        <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-open="addRouteModal">
            @await Html.PartialAsync("_Icon", "route") Add route
        </button>
        <button type="button" class="cg-btn cg-btn--primary" data-cg-modal-open="addBusModal">
            @await Html.PartialAsync("_Icon", "plus") Add bus
        </button>
    </div>
</div>

@if (ViewBag.LoadError is string loadError)
{
    <div class="cg-alert cg-alert--danger" role="alert">
        <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
        <div class="cg-alert__body">@loadError</div>
    </div>
}

<div class="cg-grid cg-grid--4">
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Buses in service</div>
            <span class="cg-kpi__icon cg-kpi__icon--success">@await Html.PartialAsync("_Icon", "bus")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@activeBuses</div>
        <div class="cg-kpi__note">@(Model.Count - activeBuses) inactive</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Drivers</div>
            <span class="cg-kpi__icon cg-kpi__icon--info">@await Html.PartialAsync("_Icon", "steering")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@drivers.Count</div>
        @if (withoutDriver > 0)
        {
            <div class="cg-kpi__note">@withoutDriver bus@(withoutDriver == 1 ? "" : "es") without a driver</div>
        }
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Students on transport</div>
            <span class="cg-kpi__icon">@await Html.PartialAsync("_Icon", "students")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@assignedStudentCount</div>
        <div class="cg-kpi__note">@unassignedStudents.Count not assigned to a bus</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Total seats</div>
            <span class="cg-kpi__icon cg-kpi__icon--neutral">@await Html.PartialAsync("_Icon", "layers")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Model.Sum(b => b.Capacity)</div>
        <div class="cg-kpi__note">Across all buses</div>
    </article>
</div>

<div class="cg-grid cg-grid--split">
    <section class="cg-card">
        <div class="cg-card__head">
            <div>
                <h2 class="cg-card__title">Fleet</h2>
                <div class="cg-card__sub">Buses, their driver and route</div>
            </div>
        </div>

        @if (!Model.Any())
        {
            @await Html.PartialAsync("_EmptyState", ("bus", "No buses yet",
                "Add a bus, then assign a driver, a route and the students who travel on it.",
                (string?)null, (string?)null))
        }
        else
        {
            <div class="cg-card__body">
                <div class="cg-grid cg-grid--2" style="margin-bottom:0">
                    @foreach (var b in Model)
                    {
                        var onBoard = b.ActiveStudentCount;
                        var load = b.Capacity == 0 ? 0 : Math.Min(100, onBoard * 100.0 / b.Capacity);
                        <div class="cg-personcard" style="flex-direction:column;gap:12px">
                            <div class="cg-row--between" style="flex-wrap:wrap">

                                <div class="cg-row">
                                    <span class="cg-kpi__icon @(b.Status == BusStatus.Active ? "cg-kpi__icon--success" : "cg-kpi__icon--neutral")">
                                        @await Html.PartialAsync("_Icon", "bus")
                                    </span>
                                    <div>
                                        <div class="cg-personcard__name cg-nowrap"><a href="/Transportation/Bus/@b.BusId">@b.BusNumber</a></div>
                                        <div class="cg-personcard__meta">@(b.RouteName ?? "No route assigned")</div>
                                    </div>
                                </div>
                                @await Html.PartialAsync("_Ui", ("bus", (object)b.Status))
                            </div>

                            <div class="cg-personcard__facts">
                                <span class="cg-personcard__fact">
                                    @await Html.PartialAsync("_Icon", "steering")
                                    @(b.DriverName ?? "No driver assigned")
                                </span>
                                <span class="cg-personcard__fact">
                                    @await Html.PartialAsync("_Icon", "students")
                                    @onBoard of @b.Capacity seats used
                                </span>
                                @if (load >= 100)
                                {
                                    <span class="cg-badge cg-badge--danger" data-cg-occupancy="full"><span class="cg-badge__dot"></span>Full</span>
                                }
                                else if (load > 90)
                                {
                                    <span class="cg-badge cg-badge--warning" data-cg-occupancy="warning"><span class="cg-badge__dot"></span>Almost full</span>
                                }
                            </div>

                            <div class="cg-bar__track">
                                <div class="cg-bar__fill @(load >= 100 ? "cg-bar__fill--danger" : load > 90 ? "cg-bar__fill--warning" : "")"
                                     style="width:@load.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>

                            <div class="cg-row cg-row--wrap" style="gap:6px">
                                <button type="button" class="cg-btn cg-btn--secondary cg-btn--sm" data-cg-modal-open="editBus-@b.BusId">
                                    @await Html.PartialAsync("_Icon", "edit") Edit
                                </button>
                                <form data-cg-ajax asp-action="BusStatus" asp-route-id="@b.BusId" method="post" class="cg-inline-form"
                                      data-cg-confirm="@(b.Status == BusStatus.Active ? $"Take {b.BusNumber} out of service? Students stay assigned to it until you change their bus." : $"Return {b.BusNumber} to service?")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="status" value="@(b.Status == BusStatus.Active ? "OutOfService" : "Active")" />
                                    <button type="submit" class="cg-btn cg-btn--ghost cg-btn--sm">
                                        @(b.Status == BusStatus.Active ? "Take out of service" : "Return to service")
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <div>
        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">Drivers</h2>
                <span class="cg-badge cg-badge--neutral">@drivers.Count</span>
            </div>
            @if (!drivers.Any())
            {
                @await Html.PartialAsync("_EmptyState", ("steering", "No drivers yet",
                    "Add a driver so buses can be attributed to a named person.",
                    (string?)null, (string?)null))
            }
            else
            {
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead><tr><th>Driver</th><th>Status</th><th class="cg-table__actions">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var d in drivers)
                        {
                            <tr>
                                <td>
                                    @* Phone and licence ride under the name: this table shares the row with the
                                       fleet, and five columns pushed the actions out of view. *@
                                    <span class="cg-identity">
                                        @await Html.PartialAsync("_Avatar", new AvatarModel(null, d.FullName, "xs"))
                                        <span class="cg-identity__body">
                                            <span class="cg-identity__name"><a href="/Transportation/Driver/@d.DriverId">@d.FullName</a></span>
                                            <span class="cg-identity__meta">
                                                <span class="cg-mono">@(d.Phone ?? "No phone")</span> · Licence @(d.LicenseNumber ?? "not recorded")
                                                @if (d.BusNumbers is { Count: > 0 } nums) { <br />@($"Drives {string.Join(", ", nums)} · {d.StudentCount} student{(d.StudentCount == 1 ? "" : "s")}") }
                                            </span>
                                        </span>
                                    </span>
                                </td>
                                <td>
                                    <span class="cg-badge @(d.Status == RecordStatus.Active ? "cg-badge--success" : "cg-badge--neutral")">
                                        <span class="cg-badge__dot"></span>@d.Status
                                    </span>
                                    @if (d.LicenceState is LicenceState.Expired or LicenceState.ExpiringSoon) { @await Html.PartialAsync("_Ui", ("licence", (object)d.LicenceState)) }
                                </td>
                                <td class="cg-table__actions">
                                    <span class="cg-row" style="gap:4px;justify-content:flex-end">
                                        <button type="button" class="cg-btn cg-btn--ghost cg-btn--sm cg-btn--icon" data-cg-modal-open="editDriver-@d.DriverId"
                                                aria-label="Edit @d.FullName" title="Edit">@await Html.PartialAsync("_Icon", "edit")</button>
                                        <form data-cg-ajax asp-action="DriverStatus" asp-route-id="@d.DriverId" method="post" class="cg-inline-form"
                                              data-cg-confirm="@(d.Status == RecordStatus.Active ? $"Deactivate {d.FullName}? They stay on record and on any bus they drive." : $"Reactivate {d.FullName}?")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@(d.Status == RecordStatus.Active ? "Inactive" : "Active")" />
                                            <button type="submit" class="cg-btn cg-btn--ghost cg-btn--sm cg-btn--icon"
                                                    aria-label="@(d.Status == RecordStatus.Active ? "Deactivate" : "Reactivate") @d.FullName"
                                                    title="@(d.Status == RecordStatus.Active ? "Deactivate" : "Reactivate")">
                                                @await Html.PartialAsync("_Icon", d.Status == RecordStatus.Active ? "user-x" : "user-check")
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">Routes</h2>
                <span class="cg-badge cg-badge--neutral">@routes.Count</span>
            </div>
            @if (!routes.Any())
            {
                @await Html.PartialAsync("_EmptyState", ("route", "No routes yet",
                    "Routes group the stops a bus serves.", (string?)null, (string?)null))
            }
            else
            {
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead><tr><th>Route</th><th>Description</th><th>Buses</th><th>Status</th><th class="cg-table__actions">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var r in routes)
                        {
                            <tr>
                                <td class="cg-strong"><a href="/Transportation/Route/@r.RouteId">@r.RouteName</a>@if (r.StopCount > 0) { <span class="cg-text-sm cg-muted"> · @r.StopCount stop@(r.StopCount == 1 ? "" : "s")</span> }</td>
                                <td class="cg-text-sm cg-muted">@(r.Description ?? "—")</td>
                                <td>@Model.Count(b => b.RouteId == r.RouteId)</td>
                                <td>
                                    <span class="cg-badge @(r.Status == RecordStatus.Active ? "cg-badge--success" : "cg-badge--neutral")">
                                        <span class="cg-badge__dot"></span>@r.Status
                                    </span>
                                </td>
                                <td class="cg-table__actions">
                                    <span class="cg-row" style="gap:4px;justify-content:flex-end">
                                        <button type="button" class="cg-btn cg-btn--ghost cg-btn--sm cg-btn--icon" data-cg-modal-open="editRoute-@r.RouteId"
                                                aria-label="Edit @r.RouteName" title="Edit">@await Html.PartialAsync("_Icon", "edit")</button>
                                        <form data-cg-ajax asp-action="RouteStatus" asp-route-id="@r.RouteId" method="post" class="cg-inline-form"
                                              data-cg-confirm="@(r.Status == RecordStatus.Active ? $"Deactivate {r.RouteName}? Buses keep it until you edit them." : $"Reactivate {r.RouteName}?")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@(r.Status == RecordStatus.Active ? "Inactive" : "Active")" />
                                            <button type="submit" class="cg-btn cg-btn--ghost cg-btn--sm cg-btn--icon"
                                                    aria-label="@(r.Status == RecordStatus.Active ? "Deactivate" : "Reactivate") @r.RouteName"
                                                    title="@(r.Status == RecordStatus.Active ? "Deactivate" : "Reactivate")">
                                                @await Html.PartialAsync("_Icon", r.Status == RecordStatus.Active ? "x-circle" : "check-circle")
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

<section class="cg-card">
    <div class="cg-card__head">
        <div>
            <h2 class="cg-card__title">Student bus assignments</h2>
            <div class="cg-card__sub">Which bus each student travels on</div>
        </div>
        @if (hasFreeSeat && unassignedStudents.Any())
        {
            <button type="button" class="cg-btn cg-btn--primary cg-btn--sm" data-cg-modal-open="assignStudentModal">
                @await Html.PartialAsync("_Icon", "plus") Assign student
            </button>
        }
    </div>

    @* Search, the status filter and sort run on the server; with JavaScript only the list region below is
       re-rendered and the URL keeps the view, so Back, Refresh and bookmarks restore it. *@
    <form method="get" action="/Transportation" class="cg-toolbar" data-cg-list="list" role="search">
        <div class="cg-row cg-toolbar__grow" style="max-width:380px">
            <div class="cg-input-group" style="flex:1">
                <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "search")</span>
                <input class="cg-input" name="search" value="@q.Search" placeholder="Search student, bus or route"
                       aria-label="Search assignments" autocomplete="off" />
            </div>
            <button class="cg-btn cg-btn--secondary" type="submit">Search</button>
        </div>
        <select class="cg-select" style="max-width:150px" name="status" data-cg-filter="status" data-cg-filter-scope="assignments"
                aria-label="Filter by assignment status">
            <option value="__all">Any status</option>
            <option value="Active" selected="@(q.Value("status") == "Active")">Active</option>
            <option value="Ended" selected="@(q.Value("status") == "Ended")">Ended</option>
        </select>
        @if (q.SortKey is not null)
        {
            <input type="hidden" name="sort" value="@q.SortKey" />
            <input type="hidden" name="dir" value="@(q.Descending ? "desc" : "asc")" />
        }
        <a class="cg-btn cg-btn--ghost cg-btn--sm" data-cg-reset data-cg-reset-scope="assignments" data-cg-list-link
           href="@q.ClearedFilters().Url()">Clear</a>
        <span class="cg-toolbar__spacer"></span>
    </form>

    @* The announcer sits outside the region: a live region replaced already filled is announced unreliably,
       so cg-ajax.js copies the new count into it. *@
    <span class="cg-sr-only" data-cg-list-status role="status" aria-live="polite"></span>
    <div data-cg-region="list">
        @if (ViewBag.ListError is string listError)
        {
            <div class="cg-card__body">
                <div class="cg-alert cg-alert--danger" role="alert">
                    <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
                    <div class="cg-alert__body">
                        <div>@listError</div>
                        <a href="@q.Url(page: q.CurrentPage)" data-cg-list-link>Try again</a>
                    </div>
                </div>
            </div>
        }
        else if (assignments.PastTheEnd)
        {
            <div class="cg-empty" data-cg-page-missing>
                <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                <div class="cg-empty__title">There is no page @assignments.Page</div>
                <p class="cg-empty__text">This list has @assignments.PageCount page@(assignments.PageCount == 1 ? "" : "s") of results now.</p>
                <a class="cg-btn cg-btn--secondary cg-btn--sm" href="@q.Url(page: assignments.PageCount)" data-cg-list-link>Go to page @assignments.PageCount</a>
            </div>
        }
        else if (assignments.Total == 0 && !q.HasFilters)
        {
            @await Html.PartialAsync("_EmptyState", ("students", "No students assigned to a bus",
                "Assign students to a bus so their boarding and drop-off checkpoints are attributed to a route.",
                (string?)null, (string?)null))
        }
        else
        {
            <div class="cg-row cg-row--between" style="padding:0 16px">
                <span class="cg-text-sm cg-muted" data-cg-count data-cg-count-scope="assignments">@assignments.Total @(assignments.Total == 1 ? "record" : "records")</span>
            </div>
            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("student", "Student", q.SortKey, q.Descending, q.Url))
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("bus", "Bus", q.SortKey, q.Descending, q.Url))
                            <th>Route</th>
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("assigned", "Assigned", q.SortKey, q.Descending, q.Url))
                            <th>Ended</th>
                            @await Html.PartialAsync("_SortHeader", new SortHeaderModel("status", "Status", q.SortKey, q.Descending, q.Url))
                            <th class="cg-table__actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var a in assignments.Items)
                {
                    // No route on the assignment means the student rides the bus's own route.
                    var busRoute = a.RouteName is null ? Model.FirstOrDefault(b => b.BusNumber == a.BusNumber)?.RouteName : null;
                    var routeShown = a.RouteName ?? busRoute;
                    <tr data-row>
                        <td><a href="/Students/Details/@a.StudentId">@a.StudentName</a></td>
                        <td><span class="cg-tag">@await Html.PartialAsync("_Icon", "bus") @a.BusNumber</span></td>
                        <td>
                            @if (a.RouteName is not null)
                            {
                                @a.RouteName
                            }
                            else if (busRoute is not null)
                            {
                                @busRoute <span class="cg-text-sm cg-muted">· bus route</span>
                            }
                            else
                            {
                                <span class="cg-muted">No route</span>
                            }
                            @if (a.PickupStop is not null || a.DropStop is not null)
                            {
                                <div class="cg-text-sm cg-muted" data-assignment-stops>Pickup @(a.PickupStop ?? "not set") · Drop-off @(a.DropStop ?? "not set")</div>
                            }
                        </td>
                        <td class="cg-text-sm cg-muted">@a.AssignedAt.ToSchoolTime().ToString("d MMM yyyy")</td>
                        <td class="cg-text-sm cg-muted">@(a.EndedAt?.ToSchoolTime().ToString("d MMM yyyy") ?? (a.Status == RecordStatus.Active ? "" : "—"))</td>
                        <td>
                            <span class="cg-badge @(a.Status == RecordStatus.Active ? "cg-badge--success" : "cg-badge--neutral")">
                                <span class="cg-badge__dot"></span>@(a.Status == RecordStatus.Active ? "Active" : "Ended")
                            </span>
                        </td>
                        <td class="cg-table__actions">
                            @if (a.Status == RecordStatus.Active)
                            {
                                <span class="cg-row" style="gap:4px;justify-content:flex-end">
                                    <button type="button" class="cg-btn cg-btn--ghost cg-btn--sm" data-cg-modal-open="changeBus-@a.Id">Change bus</button>
                                    <form data-cg-ajax asp-action="EndAssignment" asp-route-id="@a.Id" method="post" class="cg-inline-form"
                                          data-cg-confirm="End @a.StudentName's assignment to @a.BusNumber? It stays in the history.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="cg-btn cg-btn--ghost cg-btn--sm">End</button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
                    </tbody>
                </table>
            </div>

            @if (assignments.Total == 0)
            {
                <div class="cg-empty" data-cg-noresults data-cg-noresults-scope="assignments">
                    <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
                    <div class="cg-empty__title">No assignments match</div>
                    <p class="cg-empty__text">Clear the search or filter to see every assignment.</p>
                </div>
            }

            @await Html.PartialAsync("_Pager", new PagerModel("assignments", assignments.Page, assignments.PageCount, assignments.FirstRow, assignments.LastRow, assignments.Total, "assignments", p => q.Url(page: p)))

@foreach (var a in activeAssignments)
{
    <div class="cg-modal" id="changeBus-@a.Id" hidden role="dialog" aria-modal="true" aria-labelledby="changeBusTitle-@a.Id">
        <div class="cg-modal__panel">
            <div class="cg-modal__head">
                <div>
                    <h2 class="cg-modal__title" id="changeBusTitle-@a.Id">Change bus for @a.StudentName</h2>
                    <div class="cg-modal__sub">Currently on @a.BusNumber. The old assignment is kept in the history.</div>
                </div>
                <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">@await Html.PartialAsync("_Icon", "x")</button>
            </div>
            <form data-cg-ajax asp-action="AddAssignment" method="post" data-cg-busy>
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" value="@a.StudentId" />
                <div class="cg-modal__body">
                    <div class="cg-form">
                        <div class="cg-field">
                            <label class="cg-label" for="changeBusBus-@a.Id">New bus <span class="cg-label__req">*</span></label>
                            <select class="cg-select" id="changeBusBus-@a.Id" name="busId" required>
                                @foreach (var b in inServiceBuses)
                                {
                                    var current = b.BusId == a.BusId || b.BusNumber == a.BusNumber;
                                    <option value="@b.BusId" selected="@current" disabled="@(IsFull(b) && !current)">@BusOption(b)</option>
                                }
                            </select>
                        </div>
                        @if (settings.AllowRouteOverride)
                        {
                            <div class="cg-field">
                                <label class="cg-label" for="changeBusRoute-@a.Id">Route</label>
                                <select class="cg-select" id="changeBusRoute-@a.Id" name="routeId">
                                    <option value="">Use the bus's own route</option>
                                    @foreach (var r in routes.Where(r => r.Status == RecordStatus.Active))
                                    {
                                        <option value="@r.RouteId" selected="@(r.RouteName == a.RouteName)">@r.RouteName</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <p class="cg-hint">The student travels on the new bus's route. Moving ends the current assignment and starts a new one in one step.</p>
                        }
                    </div>
                </div>
                <div class="cg-modal__foot">
                    <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                    <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Change bus</span></button>
                </div>
            </form>
        </div>
    </div>
}
        }
    </div>
</section>
@* ------------------------------------------------------------------ Modals *@
<section class="cg-card" aria-labelledby="transportAuditTitle">
    <div class="cg-card__head">
        <div>
            <h2 class="cg-card__title" id="transportAuditTitle">Recent changes</h2>
            <div class="cg-card__sub">Audit trail of transport changes: who changed what, and when</div>
        </div>
    </div>
    @if (audit.Count == 0)
    {
        @await Html.PartialAsync("_EmptyState", ("activity", "No changes recorded yet", "Edits to drivers, routes, buses and assignments are listed here.", (string?)null, (string?)null))
    }
    else
    {
        <div class="cg-table-wrap">
            <table class="cg-table" data-cg-transport-audit>
                <thead><tr><th>When</th><th>Admin</th><th>Record</th><th>Change</th><th>Detail</th></tr></thead>
                <tbody>
                @foreach (var e in audit)
                {
                    <tr>
                        <td class="cg-nowrap cg-text-sm">@e.OccurredAt.ToSchoolTime().ToString("d MMM, HH:mm")</td>
                        <td>@(e.AdminName ?? (e.AdminId is null ? "System" : $"Admin #{e.AdminId}"))</td>
                        <td class="cg-nowrap">@e.EntityType #@e.EntityId</td>
                        <td><span class="cg-badge cg-badge--neutral">@e.Action</span></td>
                        <td class="cg-text-sm cg-muted">@e.Detail</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

