@model List<BusDto>
@{
    ViewData["Title"] = "Transportation";
    var routes = (List<RouteDto>)ViewBag.Routes;
    var drivers = (List<DriverDto>)ViewBag.Drivers;
    var assignments = (List<StudentBusAssignmentDto>)ViewBag.Assignments;
    var students = (List<StudentListItemDto>)ViewBag.Students;

    var activeBuses = Model.Count(b => b.Status == RecordStatus.Active);
    var withoutDriver = Model.Count(b => string.IsNullOrEmpty(b.DriverName));
    var assignedStudentIds = assignments.Select(a => a.StudentId).Distinct().ToHashSet();
    var unassignedStudents = students.Where(s => !assignedStudentIds.Contains(s.StudentId)).ToList();
}

<div class="cg-page-head">
    <div class="cg-page-head__text">
        <h1 class="cg-page-head__title">Transportation</h1>
        <p class="cg-page-head__sub">
            @activeBuses bus@(activeBuses == 1 ? "" : "es") in service · @drivers.Count driver@(drivers.Count == 1 ? "" : "s") ·
            @routes.Count route@(routes.Count == 1 ? "" : "s")
        </p>
    </div>
    <div class="cg-page-head__actions">
        <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-open="addDriverModal">
            @await Html.PartialAsync("_Icon", "steering") Add driver
        </button>
        <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-open="addRouteModal">
            @await Html.PartialAsync("_Icon", "route") Add route
        </button>
        <button type="button" class="cg-btn cg-btn--primary" data-cg-modal-open="addBusModal">
            @await Html.PartialAsync("_Icon", "plus") Add bus
        </button>
    </div>
</div>

@if (ViewBag.LoadError is string loadError)
{
    <div class="cg-alert cg-alert--danger" role="alert">
        <span class="cg-alert__icon">@await Html.PartialAsync("_Icon", "alert-circle")</span>
        <div class="cg-alert__body">@loadError</div>
    </div>
}

<div class="cg-grid cg-grid--4">
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Buses in service</div>
            <span class="cg-kpi__icon cg-kpi__icon--success">@await Html.PartialAsync("_Icon", "bus")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@activeBuses</div>
        <div class="cg-kpi__note">@(Model.Count - activeBuses) inactive</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Drivers</div>
            <span class="cg-kpi__icon cg-kpi__icon--info">@await Html.PartialAsync("_Icon", "steering")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@drivers.Count</div>
        @if (withoutDriver > 0)
        {
            <div class="cg-kpi__note">@withoutDriver bus@(withoutDriver == 1 ? "" : "es") without a driver</div>
        }
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Students on transport</div>
            <span class="cg-kpi__icon">@await Html.PartialAsync("_Icon", "students")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@assignedStudentIds.Count</div>
        <div class="cg-kpi__note">@unassignedStudents.Count not assigned to a bus</div>
    </article>
    <article class="cg-kpi">
        <div class="cg-kpi__top">
            <div class="cg-kpi__label">Total seats</div>
            <span class="cg-kpi__icon cg-kpi__icon--neutral">@await Html.PartialAsync("_Icon", "layers")</span>
        </div>
        <div class="cg-kpi__value cg-kpi__value--sm">@Model.Sum(b => b.Capacity)</div>
        <div class="cg-kpi__note">Across all buses</div>
    </article>
</div>

<div class="cg-grid cg-grid--split">
    <section class="cg-card">
        <div class="cg-card__head">
            <div>
                <h2 class="cg-card__title">Fleet</h2>
                <div class="cg-card__sub">Buses, their driver and route</div>
            </div>
        </div>

        @if (!Model.Any())
        {
            @await Html.PartialAsync("_EmptyState", ("bus", "No buses yet",
                "Add a bus, then assign a driver, a route and the students who travel on it.",
                (string?)null, (string?)null))
        }
        else
        {
            <div class="cg-card__body">
                <div class="cg-grid cg-grid--2" style="margin-bottom:0">
                    @foreach (var b in Model)
                    {
                        var onBoard = assignments.Count(a => a.BusNumber == b.BusNumber);
                        var load = b.Capacity == 0 ? 0 : Math.Min(100, onBoard * 100.0 / b.Capacity);
                        <div class="cg-personcard" style="flex-direction:column;gap:12px">
                            <div class="cg-row--between">
                                <div class="cg-row">
                                    <span class="cg-kpi__icon @(b.Status == RecordStatus.Active ? "cg-kpi__icon--success" : "cg-kpi__icon--neutral")">
                                        @await Html.PartialAsync("_Icon", "bus")
                                    </span>
                                    <div>
                                        <div class="cg-personcard__name">@b.BusNumber</div>
                                        <div class="cg-personcard__meta">@(b.RouteName ?? "No route assigned")</div>
                                    </div>
                                </div>
                                @if (b.Status == RecordStatus.Active)
                                {
                                    <span class="cg-badge cg-badge--success"><span class="cg-badge__dot"></span>In service</span>
                                }
                                else
                                {
                                    <span class="cg-badge cg-badge--neutral"><span class="cg-badge__dot"></span>Out of service</span>
                                }
                            </div>

                            <div class="cg-personcard__facts">
                                <span class="cg-personcard__fact">
                                    @await Html.PartialAsync("_Icon", "steering")
                                    @(b.DriverName ?? "No driver assigned")
                                </span>
                                <span class="cg-personcard__fact">
                                    @await Html.PartialAsync("_Icon", "students")
                                    @onBoard of @b.Capacity seats used
                                </span>
                            </div>

                            <div class="cg-bar__track">
                                <div class="cg-bar__fill @(load > 90 ? "cg-bar__fill--warning" : "")"
                                     style="width:@load.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <div>
        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">Drivers</h2>
                <span class="cg-badge cg-badge--neutral">@drivers.Count</span>
            </div>
            @if (!drivers.Any())
            {
                @await Html.PartialAsync("_EmptyState", ("steering", "No drivers yet",
                    "Add a driver so buses can be attributed to a named person.",
                    (string?)null, (string?)null))
            }
            else
            {
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead><tr><th>Driver</th><th>Phone</th><th>Licence</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var d in drivers)
                        {
                            <tr>
                                <td>
                                    <span class="cg-identity">
                                        @await Html.PartialAsync("_Avatar", new AvatarModel(null, d.FullName, "xs"))
                                        <span class="cg-identity__name">@d.FullName</span>
                                    </span>
                                </td>
                                <td class="cg-mono cg-text-sm">@(d.Phone ?? "—")</td>
                                <td class="cg-text-sm">@(d.LicenseNumber ?? "—")</td>
                                <td>
                                    <span class="cg-badge @(d.Status == RecordStatus.Active ? "cg-badge--success" : "cg-badge--neutral")">
                                        <span class="cg-badge__dot"></span>@d.Status
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="cg-card">
            <div class="cg-card__head">
                <h2 class="cg-card__title">Routes</h2>
                <span class="cg-badge cg-badge--neutral">@routes.Count</span>
            </div>
            @if (!routes.Any())
            {
                @await Html.PartialAsync("_EmptyState", ("route", "No routes yet",
                    "Routes group the stops a bus serves.", (string?)null, (string?)null))
            }
            else
            {
                <div class="cg-table-wrap">
                    <table class="cg-table">
                        <thead><tr><th>Route</th><th>Description</th><th>Buses</th></tr></thead>
                        <tbody>
                        @foreach (var r in routes)
                        {
                            <tr>
                                <td class="cg-strong">@r.RouteName</td>
                                <td class="cg-text-sm cg-muted">@(r.Description ?? "—")</td>
                                <td>@Model.Count(b => b.RouteName == r.RouteName)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

<section class="cg-card">
    <div class="cg-card__head">
        <div>
            <h2 class="cg-card__title">Student bus assignments</h2>
            <div class="cg-card__sub">Which bus each student travels on</div>
        </div>
        @if (Model.Any() && unassignedStudents.Any())
        {
            <button type="button" class="cg-btn cg-btn--primary cg-btn--sm" data-cg-modal-open="assignStudentModal">
                @await Html.PartialAsync("_Icon", "plus") Assign student
            </button>
        }
    </div>

    @if (!assignments.Any())
    {
        @await Html.PartialAsync("_EmptyState", ("students", "No students assigned to a bus",
            "Assign students to a bus so their boarding and drop-off checkpoints are attributed to a route.",
            (string?)null, (string?)null))
    }
    else
    {
        <div class="cg-toolbar">
            <div class="cg-input-group cg-toolbar__grow" style="max-width:280px">
                <span class="cg-input-group__icon">@await Html.PartialAsync("_Icon", "search")</span>
                <input class="cg-input" placeholder="Search student, bus or route"
                       data-cg-search data-cg-search-scope="assignments" aria-label="Search assignments" />
            </div>
            <span class="cg-toolbar__spacer"></span>
            <span class="cg-text-sm cg-muted" data-cg-count data-cg-count-scope="assignments"></span>
        </div>

        <div class="cg-table-wrap">
            <table class="cg-table" data-cg-table="assignments" data-cg-page-size="25">
                <thead>
                    <tr>
                        <th><span class="cg-th-sort" data-cg-sort="student">Student @await Html.PartialAsync("_Icon", "arrow-down")</span></th>
                        <th>Bus</th>
                        <th>Route</th>
                        <th>Assigned</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in assignments)
                {
                    <tr data-row data-search="@a.StudentName @a.BusNumber @a.RouteName" data-sort-student="@a.StudentName">
                        <td><a href="/Students/Details/@a.StudentId">@a.StudentName</a></td>
                        <td><span class="cg-tag">@await Html.PartialAsync("_Icon", "bus") @a.BusNumber</span></td>
                        <td>@(a.RouteName ?? "—")</td>
                        <td class="cg-text-sm cg-muted">@a.AssignedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td>
                            <span class="cg-badge @(a.Status == RecordStatus.Active ? "cg-badge--success" : "cg-badge--neutral")">
                                <span class="cg-badge__dot"></span>@a.Status
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="cg-empty" data-cg-noresults data-cg-noresults-scope="assignments" hidden>
            <div class="cg-empty__art">@await Html.PartialAsync("_Icon", "filter")</div>
            <div class="cg-empty__title">No assignments match</div>
            <p class="cg-empty__text">Clear the search to see every assignment.</p>
        </div>

        <div class="cg-pagination">
            <span class="cg-text-sm">Showing up to 25 assignments per page</span>
            <div class="cg-pagination__pages" data-cg-pager data-cg-pager-scope="assignments"></div>
        </div>
    }
</section>

@* ------------------------------------------------------------------ Modals *@
<div class="cg-modal" id="addDriverModal" hidden role="dialog" aria-modal="true" aria-labelledby="addDriverTitle">
    <div class="cg-modal__panel">
        <div class="cg-modal__head">
            <h2 class="cg-modal__title" id="addDriverTitle">Add driver</h2>
            <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">
                @await Html.PartialAsync("_Icon", "x")
            </button>
        </div>
        <form asp-action="AddDriver" method="post" data-cg-busy>
            @Html.AntiForgeryToken()
            <div class="cg-modal__body">
                <div class="cg-form">
                    <div class="cg-field">
                        <label class="cg-label" for="driverName">Full name <span class="cg-label__req">*</span></label>
                        <input class="cg-input" id="driverName" name="fullName" required maxlength="150" />
                    </div>
                    <div class="cg-form-row">
                        <div class="cg-field">
                            <label class="cg-label" for="driverPhone">Phone</label>
                            <input class="cg-input" id="driverPhone" name="phone" type="tel" maxlength="30" />
                        </div>
                        <div class="cg-field">
                            <label class="cg-label" for="driverLicence">Licence number</label>
                            <input class="cg-input" id="driverLicence" name="licenseNumber" maxlength="50" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="cg-modal__foot">
                <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Add driver</span></button>
            </div>
        </form>
    </div>
</div>

<div class="cg-modal" id="addRouteModal" hidden role="dialog" aria-modal="true" aria-labelledby="addRouteTitle">
    <div class="cg-modal__panel">
        <div class="cg-modal__head">
            <h2 class="cg-modal__title" id="addRouteTitle">Add route</h2>
            <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">
                @await Html.PartialAsync("_Icon", "x")
            </button>
        </div>
        <form asp-action="AddRoute" method="post" data-cg-busy>
            @Html.AntiForgeryToken()
            <div class="cg-modal__body">
                <div class="cg-form">
                    <div class="cg-field">
                        <label class="cg-label" for="routeName">Route name <span class="cg-label__req">*</span></label>
                        <input class="cg-input" id="routeName" name="routeName" required maxlength="100"
                               placeholder="Route A — North Zone" />
                    </div>
                    <div class="cg-field">
                        <label class="cg-label" for="routeDescription">Description</label>
                        <textarea class="cg-textarea" id="routeDescription" name="description" maxlength="500"
                                  placeholder="Which stops this route covers"></textarea>
                    </div>
                </div>
            </div>
            <div class="cg-modal__foot">
                <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Add route</span></button>
            </div>
        </form>
    </div>
</div>

<div class="cg-modal" id="addBusModal" hidden role="dialog" aria-modal="true" aria-labelledby="addBusTitle">
    <div class="cg-modal__panel">
        <div class="cg-modal__head">
            <h2 class="cg-modal__title" id="addBusTitle">Add bus</h2>
            <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">
                @await Html.PartialAsync("_Icon", "x")
            </button>
        </div>
        <form asp-action="AddBus" method="post" data-cg-busy>
            @Html.AntiForgeryToken()
            <div class="cg-modal__body">
                <div class="cg-form">
                    <div class="cg-form-row">
                        <div class="cg-field">
                            <label class="cg-label" for="busNumber">Bus number <span class="cg-label__req">*</span></label>
                            <input class="cg-input" id="busNumber" name="busNumber" required maxlength="20" placeholder="BUS-101" />
                        </div>
                        <div class="cg-field">
                            <label class="cg-label" for="busCapacity">Capacity <span class="cg-label__req">*</span></label>
                            <input class="cg-input" id="busCapacity" name="capacity" type="number" min="1" max="200" required />
                        </div>
                    </div>
                    <div class="cg-form-row">
                        <div class="cg-field">
                            <label class="cg-label" for="busDriver">Driver</label>
                            <select class="cg-select" id="busDriver" name="driverId">
                                <option value="">No driver yet</option>
                                @foreach (var d in drivers)
                                {
                                    <option value="@d.DriverId">@d.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="cg-field">
                            <label class="cg-label" for="busRoute">Route</label>
                            <select class="cg-select" id="busRoute" name="routeId">
                                <option value="">No route yet</option>
                                @foreach (var r in routes)
                                {
                                    <option value="@r.RouteId">@r.RouteName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cg-modal__foot">
                <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Add bus</span></button>
            </div>
        </form>
    </div>
</div>

<div class="cg-modal" id="assignStudentModal" hidden role="dialog" aria-modal="true" aria-labelledby="assignStudentTitle">
    <div class="cg-modal__panel">
        <div class="cg-modal__head">
            <div>
                <h2 class="cg-modal__title" id="assignStudentTitle">Assign a student to a bus</h2>
                <div class="cg-modal__sub">Only students not already on a bus are listed.</div>
            </div>
            <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">
                @await Html.PartialAsync("_Icon", "x")
            </button>
        </div>
        <form asp-action="AddAssignment" method="post" data-cg-busy>
            @Html.AntiForgeryToken()
            <div class="cg-modal__body">
                <div class="cg-form">
                    <div class="cg-field">
                        <label class="cg-label" for="assignStudent">Student <span class="cg-label__req">*</span></label>
                        <select class="cg-select" id="assignStudent" name="studentId" required>
                            @foreach (var s in unassignedStudents)
                            {
                                <option value="@s.StudentId">@s.FullName@(string.IsNullOrEmpty(s.Grade) ? "" : $" — {s.Grade}")</option>
                            }
                        </select>
                    </div>
                    <div class="cg-field">
                        <label class="cg-label" for="assignBus">Bus <span class="cg-label__req">*</span></label>
                        <select class="cg-select" id="assignBus" name="busId" required>
                            @foreach (var b in Model)
                            {
                                <option value="@b.BusId">@b.BusNumber@(string.IsNullOrEmpty(b.RouteName) ? "" : $" — {b.RouteName}")</option>
                            }
                        </select>
                    </div>
                    <div class="cg-field">
                        <label class="cg-label" for="assignRoute">Route</label>
                        <select class="cg-select" id="assignRoute" name="routeId">
                            <option value="">Use the bus's own route</option>
                            @foreach (var r in routes)
                            {
                                <option value="@r.RouteId">@r.RouteName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="cg-modal__foot">
                <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Assign student</span></button>
            </div>
        </form>
    </div>
</div>
