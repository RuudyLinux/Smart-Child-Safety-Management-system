@foreach (var b in Model)
{
    <div class="cg-modal" id="editBus-@b.BusId" hidden role="dialog" aria-modal="true" aria-labelledby="editBusTitle-@b.BusId">
        <div class="cg-modal__panel">
            <div class="cg-modal__head">
                <h2 class="cg-modal__title" id="editBusTitle-@b.BusId">Edit @b.BusNumber</h2>
                <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">@await Html.PartialAsync("_Icon", "x")</button>
            </div>
            <form asp-action="EditBus" asp-route-id="@b.BusId" method="post" data-cg-busy>
                @Html.AntiForgeryToken()
                <div class="cg-modal__body">
                    <div class="cg-form">
                        <div class="cg-form-row">
                            <div class="cg-field">
                                <label class="cg-label" for="editBusNumber-@b.BusId">Bus number <span class="cg-label__req">*</span></label>
                                <input class="cg-input" id="editBusNumber-@b.BusId" name="busNumber" value="@b.BusNumber" required maxlength="20" />
                            </div>
                            <div class="cg-field">
                                <label class="cg-label" for="editBusCapacity-@b.BusId">Capacity <span class="cg-label__req">*</span></label>
                                <input class="cg-input" id="editBusCapacity-@b.BusId" name="capacity" value="@b.Capacity" type="number" min="@Math.Max(1, b.ActiveStudentCount)" max="200" required aria-describedby="editBusCapacityHint-@b.BusId" />
                                <p class="cg-hint" id="editBusCapacityHint-@b.BusId">@b.ActiveStudentCount student(s) assigned: capacity cannot go below that.</p>
                            </div>
                        </div>
                        <div class="cg-form-row">
                            <div class="cg-field">
                                <label class="cg-label" for="editBusDriver-@b.BusId">Driver</label>
                                <select class="cg-select" id="editBusDriver-@b.BusId" name="driverId">
                                    <option value="">No driver</option>
                                    @foreach (var d in drivers.Where(d => Offer(d.Status, d.DriverId == b.DriverId)))
                                    {
                                        <option value="@d.DriverId" selected="@(d.DriverId == b.DriverId)">@d.FullName@(d.Status == RecordStatus.Active ? "" : " (inactive)")</option>
                                    }
                                </select>
                            </div>
                            <div class="cg-field">
                                <label class="cg-label" for="editBusRoute-@b.BusId">Route</label>
                                <select class="cg-select" id="editBusRoute-@b.BusId" name="routeId">
                                    <option value="">No route</option>
                                    @foreach (var r in routes.Where(r => Offer(r.Status, r.RouteId == b.RouteId)))
                                    {
                                        <option value="@r.RouteId" selected="@(r.RouteId == b.RouteId)">@r.RouteName@(r.Status == RecordStatus.Active ? "" : " (inactive)")</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cg-modal__foot">
                    <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                    <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Save bus</span></button>
                </div>
            </form>
        </div>
    </div>
}

@foreach (var a in activeAssignments)
{
    <div class="cg-modal" id="changeBus-@a.Id" hidden role="dialog" aria-modal="true" aria-labelledby="changeBusTitle-@a.Id">
        <div class="cg-modal__panel">
            <div class="cg-modal__head">
                <div>
                    <h2 class="cg-modal__title" id="changeBusTitle-@a.Id">Change bus for @a.StudentName</h2>
                    <div class="cg-modal__sub">Currently on @a.BusNumber. The old assignment is kept in the history.</div>
                </div>
                <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">@await Html.PartialAsync("_Icon", "x")</button>
            </div>
            <form asp-action="AddAssignment" method="post" data-cg-busy>
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" value="@a.StudentId" />
                <div class="cg-modal__body">
                    <div class="cg-form">
                        <div class="cg-field">
                            <label class="cg-label" for="changeBusBus-@a.Id">New bus <span class="cg-label__req">*</span></label>
                            <select class="cg-select" id="changeBusBus-@a.Id" name="busId" required>
                                @foreach (var b in inServiceBuses)
                                {
                                    var current = b.BusId == a.BusId || b.BusNumber == a.BusNumber;
                                    <option value="@b.BusId" selected="@current" disabled="@(IsFull(b) && !current)">@BusOption(b)</option>
                                }
                            </select>
                        </div>
                        @if (settings.AllowRouteOverride)
                        {
                            <div class="cg-field">
                                <label class="cg-label" for="changeBusRoute-@a.Id">Route</label>
                                <select class="cg-select" id="changeBusRoute-@a.Id" name="routeId">
                                    <option value="">Use the bus's own route</option>
                                    @foreach (var r in routes.Where(r => r.Status == RecordStatus.Active))
                                    {
                                        <option value="@r.RouteId" selected="@(r.RouteName == a.RouteName)">@r.RouteName</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <p class="cg-hint">The student travels on the new bus's route. Moving ends the current assignment and starts a new one in one step.</p>
                        }
                    </div>
                </div>
                <div class="cg-modal__foot">
                    <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
                    <button type="submit" class="cg-btn cg-btn--primary"><span class="cg-btn__label">Change bus</span></button>
                </div>
            </form>
        </div>
    </div>
}
