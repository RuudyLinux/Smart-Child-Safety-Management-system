        <div class="cg-modal__panel">
            <div class="cg-modal__head">
                <h2 class="cg-modal__title" id="editRouteTitle-@r.RouteId">Edit route</h2>
                <button type="button" class="cg-iconbtn" data-cg-modal-close aria-label="Close">@await Html.PartialAsync("_Icon", "x")</button>
            </div>
            <form asp-action="EditRoute" asp-route-id="@r.RouteId" method="post" data-cg-busy>
                @Html.AntiForgeryToken()
                <div class="cg-modal__body">
                    <div class="cg-form">
                        <div class="cg-field">
                            <label class="cg-label" for="editRouteName-@r.RouteId">Route name <span class="cg-label__req">*</span></label>
                            <input class="cg-input" id="editRouteName-@r.RouteId" name="routeName" value="@r.RouteName" required maxlength="100" />
                        </div>
                        <div class="cg-field">
                            <label class="cg-label" for="editRouteDescription-@r.RouteId">Description</label>
                            <textarea class="cg-textarea" id="editRouteDescription-@r.RouteId" name="description" maxlength="500">@r.Description</textarea>
                        </div>
                    </div>
                </div>
                <div class="cg-modal__foot">
                    <button type="button" class="cg-btn cg-btn--secondary" data-cg-modal-close>Cancel</button>
